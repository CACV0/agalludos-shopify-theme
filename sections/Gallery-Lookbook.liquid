{{ 'section-gallery.css' | asset_url | stylesheet_tag }}
{{ 'section-gallery-lookbook.css' | asset_url | stylesheet_tag }}
<script defer src="{{ 'gallery-lookbook.js' | asset_url }}"></script>
<script defer src="{{ 'section-shoppable-feed.js' | asset_url }}"></script>

{% style %}
  /* The lookbook popup is authored inline in the block and only moved to <body> by JS. The rule
     that hides it lives in section-gallery-lookbook.css, whose <link> is re-injected with the
     section — so on a theme editor re-render the dialog can paint full screen for a frame before
     that stylesheet applies. Repeating the rule inline keeps it hidden from parse time. */
  lookbook-popup:not(.lookbook-popup--ready) {
    display: none;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | append: 'px' }};
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    }
  }
{% endstyle %}

{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'top' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div class="spacer border-top"></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}

{%- comment -%}
  <media-cards> makes a manually started video pause whichever one was playing before it,
  the same wrapper Multi Column uses. It deliberately ignores players carrying media-autoplay,
  so with autoplay on every video still plays concurrently.
{%- endcomment -%}
<media-cards
  class="d-block gallery-lookbook section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  aria-label="Gallery Lookbook"
  role="region"
>
  {%- comment -%}
    Every block renders itself: the shared Content Block emits its text, the Media group emits
    the grid / carousel. Nothing is captured or filtered here, and block order decides whether
    the copy sits above or below the media.
  {%- endcomment -%}
  {% content_for 'blocks' %}
</media-cards>

{%- comment -%}
  One popup shell for the whole section — the per-card body lives in a <template> on each trigger
  and is copied in on open. Rendered outside <media-cards> so it is not duplicated by the grid /
  carousel trees above, and JS portals it to <body> on connect either way.
{%- endcomment -%}
{%- if section.settings.show_popup -%}
  {% render 'lookbook-popup', section: section %}
{%- endif -%}

{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'bottom' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div class="spacer border-top"></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}

{% schema %}
{
  "name": "Gallery Lookbook",
  "tag": "section",
  "blocks": [
    { "type": "_content-block" },
    { "type": "_media-group" }
  ],
  "settings": [
    {
      "type": "checkbox",
      "label": "Full width",
      "id": "full_width",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "number_of_columns",
      "label": "Number of columns",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Desktop",
      "options": [
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "select",
      "id": "layout_style_mobile",
      "label": "Mobile",
      "options": [
        {
          "label": "Carousel",
          "value": "carousel"
        },
        {
          "label": "Grid",
          "value": "grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Carousel settings",
      "visible_if": "{{ section.settings.layout_style == 'carousel' or section.settings.layout_style_mobile == 'carousel' }}"
    },
    {
      "type": "checkbox",
      "id": "slider_autoplay",
      "label": "Enable animation",
      "visible_if": "{{ section.settings.layout_style == 'carousel' or section.settings.layout_style_mobile == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "slide_duration",
      "label": "Slide duration",
      "min": 650,
      "max": 3000,
      "unit": "ms",
      "step": 50,
      "default": 750,
      "info": "This setting will update slide transition speed",
      "visible_if": "{{ section.settings.slider_autoplay and section.settings.layout_style == 'carousel' or section.settings.slider_autoplay and section.settings.layout_style_mobile == 'carousel' }}"
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Change slides every",
      "min": 0,
      "max": 15,
      "unit": "s",
      "default": 5,
      "visible_if": "{{ section.settings.slider_autoplay and section.settings.layout_style == 'carousel' or section.settings.slider_autoplay and section.settings.layout_style_mobile == 'carousel' }}"
    },
    {
      "type": "header",
      "content": "Block settings"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Media ratio",
      "options": [
        {
          "label": "Portrait (3:4)",
          "value": "portrait"
        },
        {
          "label": "Square (1:1)",
          "value": "square"
        },
        {
          "label": "Adapt to image",
          "value": "adapt"
        },
        {
          "label": "Landscape (4:3)",
          "value": "landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "media_autoplay",
      "label": "Enable video autoplay",
      "info": "Video will be muted",
      "default": true
    },
    {
      "type": "select",
      "id": "column_spacing",
      "label": "Column spacing",
      "options": [
        {
          "label": "None",
          "value": "0"
        },
        {
          "label": "Small",
          "value": "16"
        },
        {
          "label": "Medium",
          "value": "24"
        },
        {
          "label": "Large",
          "value": "38"
        }
      ],
      "default": "16"
    },
    {
      "type": "header",
      "content": "Lookbook popup"
    },
    {
      "type": "checkbox",
      "id": "show_popup",
      "label": "Show popup",
      "default": false
    },
    {
      "type": "text",
      "id": "popup_heading",
      "label": "Heading",
      "default": "Get the look",
      "visible_if": "{{ section.settings.show_popup }}"
    },
    {
      "type": "select",
      "id": "popup_heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" },
        { "value": "h4", "label": "H4" },
        { "value": "h5", "label": "H5" },
        { "value": "h6", "label": "H6" }
      ],
      "visible_if": "{{ section.settings.show_popup }}"
    },
    {
      "type": "select",
      "id": "popup_heading_size",
      "label": "Size",
      "options": [
        { "label": "H1", "value": "h1" },
        { "label": "H2", "value": "h2" },
        { "label": "H3", "value": "h3" },
        { "label": "H4", "value": "h4" },
        { "label": "H5", "value": "h5" },
        { "label": "H6", "value": "h6" }
      ],
      "default": "h1",
      "visible_if": "{{ section.settings.show_popup }}"
    },
    {
      "type": "color",
      "id": "popup_text_color",
      "label": "Heading text color",
      "default": "#000000",
      "visible_if": "{{ section.settings.show_popup }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border",
      "options": [
        {
          "label": "Hide",
          "value": "hide"
        },
        {
          "label": "Full width",
          "value": "full_width"
        },
        {
          "label": "Fixed width",
          "value": "fixed_width"
        }
      ],
      "default": "hide"
    },
    {
      "type": "select",
      "id": "border_position",
      "label": "Border position",
      "options": [
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "both"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    }  
  ],
  "presets": [
    {
      "name": "Gallery Lookbook",
      "blocks": [
        {
          "type": "_content-block",
          "blocks": [
            { "type": "sub-heading" },
            { "type": "heading" },
            { "type": "paragraph" },
            { "type": "button" }
          ]
        },
        {
          "type": "_media-group",
          "blocks": [
            { "type": "_media-lookbook" },
            { "type": "_media-lookbook" },
            { "type": "_media-lookbook" }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
