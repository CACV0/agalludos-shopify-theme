{{ 'section-look-book.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | append: 'px' }};
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    }
  }
  .desktop-only-grid {
    display: none;
  }
  .mobile-only-carousel {
    display: block;
  }
  @media screen and (min-width: 750px) {
    .desktop-only-grid {
      display: block;
    }
    .mobile-only-carousel {
      display: none;
    }
  }
  .look-book-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--grid-desktop-horizontal-spacing, 32px);
    row-gap: var(--grid-desktop-vertical-spacing, 32px);
    padding-right: 32px;
  }
  @media screen and (max-width: 749px) {
    .look-book-grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: var(--grid-mobile-horizontal-spacing, 16px);
      row-gap: var(--grid-mobile-vertical-spacing, 32px);
      padding: 0 24px;
    }
  }
{%- endstyle -%}

{% liquid
  assign loading = 'eager'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  elsif section.index > 2
    assign loading = 'lazy'
    assign intersection = 'intersection-element'
  endif

  assign page_width = settings.page_width
  assign widths = '500, 780, 1060, 1280'

  # When layout is 'grid', both mobile-only-carousel and desktop-only-grid render simultaneously.
  # Give each a distinct layout_block so their form IDs don't collide for the same product.
  # The desktop-only-grid is also CSS-hidden on mobile, so it never needs a mobile bottom-sheet.
  assign lb_grid_skip_mobile = false
  assign lb_carousel_layout_block = blank
  if section.settings.layout == 'grid'
    assign lb_grid_skip_mobile = true
    assign lb_carousel_layout_block = 'carousel'
  endif
%}

{%- capture sizes -%}
  {%- unless section.settings.full_width -%}
    (min-width: {{ page_width }}px) {{ page_width | minus: 100 | divided_by: 2 }}px,
    (min-width: 768px) calc(50vw - 50px), calc(100vw - 200px)
    {%- else -%}
    (min-width: 768px) calc(50vw - 50px), calc(100vw - 200px)
  {%- endunless -%}
{%- endcapture -%}
{% capture border_radius_box %}
{% unless section.settings.full_width %}  border-radius--block {% else %} border-radius--right-box-corner{% endunless %}
{% endcapture %}
{% liquid
  assign backgroundContent = ''
  assign foregroundContent = ''
  assign productsContent = ''
  assign first_foreground_image = null
%}

{% for block in section.blocks %}
  {% assign isFirstLoop = forloop.first %}
  {% assign products_to_show = block.settings.products_to_show %}
  {% liquid
    assign overlay_rgba_color = block.settings.overlay_color.rgba
    if forloop.first
      if block.settings.image_foreground != blank
        assign first_foreground_image = block.settings.image_foreground
      elsif block.settings.collection != blank and block.settings.collection.featured_image != blank
        assign first_foreground_image = block.settings.collection.featured_image
      endif
    endif
  %}
  {%- capture backgroundBlock -%}
    <div class="lookBook__backgroundContainer h-100 position-absolute{% unless isFirstLoop %} opacity-0{% endunless %}" data-bg-slide-id="{{ block.id }}" image-container>
      <animation-reveal aoi-type="zoom-out" aoi-duration="0.7" aoi-amount="0" class="h-100 position-relative">
        <div class="image_overlay position-absolute" style="background-color:rgba({{ overlay_rgba_color }})"></div>
        {% if block.settings.image_background != blank %}
          {%- capture imagealt -%}
            {{ block.settings.image_background.alt | default: 'image' }}
          {%- endcapture -%}

          {% capture background_image_class %}
          set-100-percentage-size-media border-radius {{ border_radius_box }} image-responsive
          {% endcapture %}
          {{ block.settings.image_background
          | image_url: width: block.settings.image_background.width
          | image_tag: loading: loading
          , fetchpriority: fetchpriority
          , sizes: sizes, widths: widths
          , class: background_image_class
          , is: 'image-loading'
          , alt: imagealt }}
        {% else %}
          {{ "hero-apparel-1" | placeholder_svg_tag: "h-100 w-100" }}
        {% endif %}
      </animation-reveal>
      {% if block.settings.image_background != blank %}
        {{ block.settings.image_background
        | image_url: width: 40
        | image_tag:
          alt: block.settings.image_background.alt,
          class: 'blur-image',
          loading: loading,
          fetchpriority: fetchpriority
        }}
      {% endif %}
    </div>
  {%- endcapture -%}
  {% assign backgroundContent = backgroundContent | append: backgroundBlock %}

  {%- capture foregroundBlock -%}
  <div class="lookBook__foregroundContainer swiper-slide" data-block-id="{{ block.id }}" {{ block.shopify_attributes }}>
    <div class="lookBook__foregroundBlock border-radius border-radius--block d-v-center justify-content-center h-100">
      <div class="lookBook__foreground-imageWrp image--aspectSize aspect-ratio-{{ section.settings.image_ratio }}{% if section.settings.disable_foreground %} opacity-0{% endif %}" {% if section.settings.image_ratio == 'adapt' %} style="--aspect-ratio: {{ block.settings.image_foreground.aspect_ratio | default: block.settings.collection.featured_image.aspect_ratio | default: 1 }};"{%- endif -%}>
        {% assign className = "set-100-percentage-size-media border-radius border-radius--block image-responsive" %}
        {% if block.settings.image_foreground == blank and block.settings.collection != blank %}
          {%- capture imagealt -%}
            {{ block.settings.collection.featured_image.alt | default: 'image' }}
          {%- endcapture -%}
          {{ block.settings.collection.featured_image
          | image_url: width: block.settings.collection.featured_image.width
          | image_tag: loading: loading
          , fetchpriority: fetchpriority
          , sizes: sizes, widths: widths
          , class: className
          , is: 'image-loading'
          , alt: imagealt }}
          {{ block.settings.collection.featured_image
          | image_url: width: 40
          | image_tag:
            alt: block.settings.collection.featured_image.alt,
            class: 'blur-image',
            loading: loading,
            fetchpriority: fetchpriority
          }}
        {% elsif block.settings.image_foreground != blank %}
          {%- capture imagealt -%}
            {{ block.settings.image_foreground.alt | default: 'image' }}
          {%- endcapture -%}
          {{ block.settings.image_foreground
          | image_url: width: block.settings.image_foreground.width
          | image_tag: loading: loading
          , fetchpriority: fetchpriority
          , sizes: sizes, widths: widths
          , class: className
          , is: 'image-loading'
          , alt: imagealt }}
          {{ block.settings.image_foreground
          | image_url: width: 40
          | image_tag:
            alt: block.settings.image_foreground.alt,
            class: 'blur-image',
            loading: loading,
            fetchpriority: fetchpriority
          }}
        {% else %}
          {{ "hero-apparel-2" | placeholder_svg_tag: className }}
        {% endif %}
      </div>
      <div class="text-center mt-16 mb-16 lookBook__foregroundHeading position-absolute d-flex justify-content-center align-item-center w-100">
        {% if block.settings.link != blank or block.settings.collection != blank %}
          <a href="{{ block.settings.link | default: block.settings.collection.url }}" class="link" target="_top">
        {% endif %}
            <{{block.settings.heading_tag}} class="{{ block.settings.style }} mt-0 mb-0">{{ block.settings.caption | default: block.settings.collection.title }}</{{block.settings.heading_tag}}>
        {% if block.settings.link != blank or block.settings.collection != blank %}
        </a>
        {% endif %}
        </div>
    </div>
  </div>
  {%- endcapture -%}
  {% assign foregroundContent = foregroundContent | append: foregroundBlock %}

  {%- capture productsBlock -%}
      {% liquid
        assign productsForSlider = block.settings.collection.products
        if block.settings.product_list.count > 0
          assign productsForSlider = block.settings.product_list
        endif
      %}

      {% for product in productsForSlider limit: products_to_show %}
        <div class="h-auto{% if isFirstLoop %} swiper-slide {% else %} d-none{% endif %}" data-product-slide-id="{{ block.id }}">
          {%- render 'card-product',
            product: product,
            product_image_loading: loading,
            product_image_fetchpriority: fetchpriority,
            section: section,
            index: forloop.index0,
            allow_variant_popup: true,
            layout_block: lb_carousel_layout_block
          -%}
        </div>
      {% else %}
        {%- for i in (1..products_to_show) -%}
          <div class="h-auto{% if isFirstLoop %} swiper-slide {% else %} d-none{% endif %}" data-product-slide-id="{{ block.id }}">
            {%- render 'card-product', onboarding: true , index: forloop.index0 -%}
          </div>
        {%- endfor -%}
      {% endfor %}
  {%- endcapture -%}
  {% assign productsContent = productsContent | append: productsBlock %}
{% endfor %}
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'top' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-top"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
<div
  aria-label="Look book"
  class="lookBook__section section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  role="region"
>
  <div class="container section-header lookBook__headingWrp text-{{ section.settings.content_alignment }} mobile-sm-only">
    <animation-reveal class="d-inline-block" aoi-type="stagger" aoi-delay="0.1" aoi-duration="0.4" aoi-amount="0.3">
      {% if section.settings.subheading != blank %}
        <p class="lookBook__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="{{ section.settings.style }} mt-0 mb-16">
          {{- section.settings.heading -}}
        </{{ section.settings.heading_tag }}>
      {% endif %}
      {% if section.settings.content != blank %}
        <p class="lookBook__description fnt-16">{{ section.settings.content }}</p>
      {% endif %}
    </animation-reveal>
  </div>

  {% unless section.settings.full_width %}
    <div class="right-container">
  {% endunless %}

  <div class="lookBook">
    <div class="lookBook__container d-flex flex-wrap" style="--media-width: 46%">
      <div class="lookBook__lookWrp position-relative h-100 border-radius {{ border_radius_box }}">
        <div class="lookBook__foregroundWrp ratio-{{ section.settings.image_ratio }} d-flex align-item-end w-100 h-100 position-relative" image-container>
          <look-book-carousel
            {{ intersection }}
            dynamic-navigation-color
            class="d-block w-100 h-100 mobile-content-over-media color-{{ section.settings.color_scheme_media }}"
            slide-layout-type="carousel"
            slide-pagination-type="bullets"
            slide-per-view="1"
            slide-responsive-breakpoints='{"320":{"slidesPerView":"1"},"768":{"slidesPerView":"1"}}'
            slide-speed="{{ settings.slide_duration }}"
            animate-on-slide-change
            slide-animation="slide"
            aria-label="Slider"
          >
            <div
              class="js-element swiper swiper-container h-100 d-flex align-item-center "
              main-slider
              style="--pagination-width: {{ section.blocks.size }}"
            >
              <animation-reveal aoi-type="fade-up" aoi-amount="0.2" class="swiper-wrapper">
                {{ foregroundContent }}
              </animation-reveal>
            </div>
            <div class="sliderControl js-element position-absolute">
              <div class="d-flex sliderPagination w-100 justify-content-space-btw">
                <!-- next / prev arrows -->
                <div
                  aria-label="{{ 'accessibility.prev_slide_label' | t }}"
                  class=""
                  role="button"
                  slide-prev
                  tabindex="0"
                >
                  <div class="sliderPagination__prev productSlider__prev d-block m-0">
                    {% render 'icon', icon: 'left' %}
                  </div>
                </div>
                <div
                  aria-label="{{ 'accessibility.next_slide_label' | t }}"
                  class=""
                  role="button"
                  slide-next
                  tabindex="0"
                >
                  <div class="sliderPagination__next productSlider__next d-block m-0">
                    {% render 'icon', icon: 'right' %}
                  </div>
                </div>

                <!-- !next / prev arrows -->
              </div>
            </div>
            <noscript>
              <div
                class="swiper swiper-container swiper-initialized h-100 d-flex align-item-center"
                main-slider
                style="--pagination-width: {{ section.blocks.size }}"
              >
                {{ foregroundContent }}
              </div>
            </noscript>
          </look-book-carousel>
          {% if first_foreground_image != blank %}
            {{ first_foreground_image | image_url: width: 40 | image_tag: alt: first_foreground_image.alt, class: 'blur-image', loading: loading, fetchpriority: fetchpriority }}
          {% endif %}
        </div>
        <div class="lookBook__backgroundWrp position-absolute">
          {{ backgroundContent }}
        </div>
      </div>
      <div class="lookBook__contentWrp flex-1 d-flex d-flex-dir-c justify-content-center">
        <div class="lookBook__headingWrp section-header text-{{ section.settings.content_alignment }} tab-only">
          <animation-reveal
            class="d-inline-block"
            aoi-type="stagger"
            aoi-delay="0.1"
            aoi-duration="0.4"
            aoi-amount="0.3"
          >
            {% if section.settings.subheading != blank %}
              <p class="lookBook__subheading">{{ section.settings.subheading }}</p>
            {% endif %}
            {% if section.settings.heading != blank %}
              <{{ section.settings.heading_tag }} class="{{ section.settings.style }} mt-0 mb-16">
                {{- section.settings.heading -}}
              </{{ section.settings.heading_tag }}>
            {% endif %}
            {% if section.settings.content != blank %}
              <p class="lookBook__description fnt-16">{{ section.settings.content }}</p>
            {% endif %}
          </animation-reveal>
        </div>
        {% if section.settings.layout == 'carousel' %}
          <carousel-component
            {{ intersection }}
            dynamic-navigation-color
            class="swiper w-100 mobile-content-over-media js-element product_collection"
            slide-layout-type="carousel"
            slide-pagination-type="progressbar"
            slide-per-view="2.5"
            slide-grab-cursor="{{ settings.enable_grab_cursor }}"
            slide-responsive-breakpoints='{"320":{"slidesPerView":"2.1"},"768":{"slidesPerView":"1.25"},"1024":{"slidesPerView":"2"},"1300":{"slidesPerView":"2.5"}}'
            slide-speed="{{ settings.slide_duration }}"
            slide-no-center
            animate-on-slide-change
            slide-keyboard-disabled
            slide-animation="slide"
            aria-label="Slider"
          >
            <div class="swiper-container" main-slider style="--pagination-width: {{ section.blocks.size }}">
              <animation-reveal aoi-type="fade-up" aoi-amount="0.2" class="swiper-wrapper">
                {{ productsContent }}
              </animation-reveal>
            </div>
            <div class="sliderControl">
              <div
                aria-hidden="true"
                class="sliderProgressBar"
                slide-progress
              ></div>
              <div class="d-flex sliderPagination">
                <!-- next / prev arrows -->
                <div
                  aria-label="{{ 'accessibility.prev_slide_label' | t }}"
                  class=""
                  role="button"
                  slide-prev
                  tabindex="0"
                >
                  <div class="sliderPagination__prev productSlider__prev">
                    {% render 'icon', icon: 'left' %}
                  </div>
                </div>
                <div
                  aria-label="{{ 'accessibility.next_slide_label' | t }}"
                  class=""
                  role="button"
                  slide-next
                  tabindex="0"
                >
                  <div class="sliderPagination__next productSlider__next">
                    {% render 'icon', icon: 'right' %}
                  </div>
                </div>

                <!-- !next / prev arrows -->
              </div>
            </div>
          </carousel-component>
          <noscript class="lookBook__productsWrp product_collection">
            <div class="lookBook__productsSlider">
              {{ productsContent }}
            </div>
          </noscript>
        {% else %}
          <div class="mobile-only-carousel">
            <carousel-component
              {{ intersection }}
              dynamic-navigation-color
              class="swiper w-100 mobile-content-over-media js-element product_collection"
              slide-layout-type="carousel"
              slide-pagination-type="progressbar"
              slide-per-view="2.5"
              slide-grab-cursor="{{ settings.enable_grab_cursor }}"
              slide-responsive-breakpoints='{"320":{"slidesPerView":"2.1"},"768":{"slidesPerView":"1.25"},"1024":{"slidesPerView":"2"},"1300":{"slidesPerView":"2.5"}}'
              slide-speed="{{ settings.slide_duration }}"
              slide-no-center
              animate-on-slide-change
              slide-keyboard-disabled
              slide-animation="slide"
              aria-label="Slider"
            >
              <div class="swiper-container" main-slider style="--pagination-width: {{ section.blocks.size }}">
                <animation-reveal aoi-type="fade-up" aoi-amount="0.2" class="swiper-wrapper">
                  {{ productsContent }}
                </animation-reveal>
              </div>
              <div class="sliderControl">
                <div
                  aria-hidden="true"
                  class="sliderProgressBar"
                  slide-progress
                ></div>
                <div class="d-flex sliderPagination">
                  <!-- next / prev arrows -->
                  <div
                    aria-label="{{ 'accessibility.prev_slide_label' | t }}"
                    class=""
                    role="button"
                    slide-prev
                    tabindex="0"
                  >
                    <div class="sliderPagination__prev productSlider__prev">
                      {% render 'icon', icon: 'left' %}
                    </div>
                  </div>
                  <div
                    aria-label="{{ 'accessibility.next_slide_label' | t }}"
                    class=""
                    role="button"
                    slide-next
                    tabindex="0"
                  >
                    <div class="sliderPagination__next productSlider__next">
                      {% render 'icon', icon: 'right' %}
                    </div>
                  </div>

                  <!-- !next / prev arrows -->
                </div>
              </div>
            </carousel-component>
            <noscript class="lookBook__productsWrp product_collection">
              <div class="lookBook__productsSlider">
                {{ productsContent }}
              </div>
            </noscript>
          </div>
          <div class="desktop-only-grid">
            <div class="lookBook__productsWrp product_collection">
              <div class="look-book-grid">
                {% for block in section.blocks %}
                  {% liquid
                    assign productsForGrid = block.settings.collection.products
                    if block.settings.product_list.count > 0
                      assign productsForGrid = block.settings.product_list
                    endif
                    assign products_to_show = block.settings.products_to_show
                  %}

                  {% for product in productsForGrid limit: products_to_show %}
                    <div class="h-auto" data-product-slide-id="{{ block.id }}">
                      {%- render 'card-product',
                        product: product,
                        product_image_loading: loading,
                        product_image_fetchpriority: fetchpriority,
                        section: section,
                        index: forloop.index0,
                        allow_variant_popup: true,
                        layout_block: 'grid',
                        skip_mobile_popup: lb_grid_skip_mobile
                      -%}
                    </div>
                  {% else %}
                    {%- for i in (1..products_to_show) -%}
                      <div class="h-auto" data-product-slide-id="{{ block.id }}">
                        {%- render 'card-product', onboarding: true, index: forloop.index0 -%}
                      </div>
                    {%- endfor -%}
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>

  {% unless section.settings.full_width %}
    </div>
  {% endunless %}
</div>
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'bottom' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-bottom"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
{% schema %}
{
  "name": "Look book",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Style",  
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
    },
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Look book"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Size",
      "options": [
        {
          "label": "H1",
          "value": "h1"
        },
        {
          "label": "H2",
          "value": "h2"
        },
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "header",
      "content": "Block settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Foreground image ratio",
      "options": [
        {
          "label": "Portrait (3:4)",
          "value": "portrait"
        },
        {
          "label": "Square (1:1)",
          "value": "square"
        },
        {
          "label": "Adapt to image",
          "value": "adapt"
        },
        {
          "label": "Landscape (4:3)",
          "value": "landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "disable_foreground",
      "label": "Disable foreground",
      "default": false,
      "info": "Shows only the background image"
    },
    {
      "type": "header",
      "content": "Product card"
    },
    {
      "type": "checkbox",
      "id": "enable_product_card_background",
      "label": "Override product card colors",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "product_card_color_scheme",
      "label": "Product card color scheme",
      "default": "scheme-1",
      "info": "Applies the selected scheme's background, text and offer text color to the product cards.",
      "visible_if": "{{ section.settings.enable_product_card_background }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
