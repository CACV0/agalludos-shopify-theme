{{ 'section-marquee.css' | asset_url | stylesheet_tag }}

{% style %}
    /* Enable animation */
    .enable-animation .marquee__content-{{ section.id }}{
      animation: {{ section.settings.marquee_speed | append: 's linear infinite scroll;' }}

    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | append: 'px;' }}
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | append: 'px;' }}
    }
    .marquee__content-{{ section.id }} .marquee-text {
      font-size: {{ section.settings.mobile_text_size | append: 'px;' }};
      color: var(--color-text);
    }
    @media screen and (min-width: 750px) {
    .marquee__content-{{ section.id }} .marquee-text {
      font-size: {{ section.settings.marquee_text_size | append: 'px;' }};
    }
  }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | append: 'px;' }}
        padding-bottom: {{ section.settings.padding_bottom | append: 'px;' }}
      }
    }
    {% assign imageblock = section.blocks | where : 'type', 'image' %}

    {% for block in imageblock %}
      #marquee-image--{{ block.id }}{
        width: {{ block.settings.icon_width_mobile | append: 'px' }};

      }

      @media screen and (min-width: 750px) {
        #marquee-image--{{ block.id }}{
          width: {{ block.settings.icon_width | append: 'px' }};

        }
      }
    {% endfor %}
{% endstyle %}
{% liquid
  assign loading = 'eager'
  assign fetchpriority = 'auto'
  if section.index == 1
    assign fetchpriority = 'high'
  elsif section.index > 2
    assign loading = 'lazy'
  endif
%}
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'top' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-top"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
{% unless section.settings.full_width %}
  <div class="container">
{% endunless %}
<div
  aria-label="Marquee Section"
  class="homeMarque section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} {% unless section.settings.full_width %} border-radius border-radius--block {% endunless %}"
  role="region"
>
  <div aria-live="polite" class="marquee marquee--hover-pause enable-animation">
    <div class="marquee__content marquee__content-{{ section.id }}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'image' %}
            {% if block.settings.marquee_image != blank %}
              <div
                aria-label="Marquee Section image"
                class="Marquee-tag__image aspect-ratio-{{ block.settings.image_aspect_ratio }} {% if block.settings.link != blank and block.settings.image_fit == 'cover' %} marquee-image-hover {% endif %}"
                id="marquee-image--{{ block.id }}"
                role="img"
                style="
                  --object-fit: {{ block.settings.image_fit }};
                  {% if block.settings.image_fit == 'cover' %} --image-corner-radius: {{ block.settings.image_corner_radius | append: '%' }} {% endif %}
                "
                {{ block.shopify_attributes }}
                image-container
              >
                {% capture sizes %}
                (min-width:768px) {{ block.settings.icon_width | append: 'px' }}, {{ block.settings.icon_width_mobile | append: "px" }}
              {% endcapture %}
                {% if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
                {% endif %}

                {{
                  block.settings.marquee_image
                  | image_url: width: block.settings.marquee_image.width
                  | image_tag:
                    class: 'marquee-log image-responsive',
                    widths: '350,250,100',
                    sizes: sizes,
                    loading: 'lazy',
                    alt: block.settings.marquee_image.alt,
                    loading: loading,
                    fetchpriority: fetchpriority,
                    is: 'image-loading'
                }}
                {% if block.settings.link != blank %}</a>{% endif %}
                {{
                  block.settings.marquee_image
                  | image_url: width: 5
                  | image_tag:
                    alt: block.settings.marquee_image.alt,
                    class: 'blur-image',
                    loading: loading,
                    fetchpriority: fetchpriority
                }}
              </div>
            {% else %}
              <div
                aria-label="Marquee Section image"
                class="Marquee-tag__image"
                id="marquee-image--{{ block.id }}"
                role="img"
              >
                {% if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
                {% endif %}
                {{ 'image' | placeholder_svg_tag }}
                {% if block.settings.link != blank %}</a>{% endif %}
              </div>
            {% endif %}
          {% when 'content' %}
            <div
              aria-label="{{ block.settings.text }}"
              style="{% if block.settings.use_custom_color %} --color-text: {{ block.settings.color_custom }} {% endif %}"
              class="Marquee-tag marquee__text-color"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
              {% endif %}
              <p class="marquee-text">{{ block.settings.text }}</p>
              {% if block.settings.link != blank %}</a>{% endif %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>
    {% for i in (1..9) %}
      <div aria-hidden="true" class="marquee__content marquee__content-{{ section.id }}">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'image' %}
              {% if block.settings.marquee_image != blank %}
                <div
                  aria-label="Marquee Section image"
                  class="Marquee-tag__image aspect-ratio-{{ block.settings.image_aspect_ratio }} {% if block.settings.link != blank and block.settings.image_fit == 'cover' %} marquee-image-hover {% endif %}"
                  id="marquee-image--{{ block.id }}"
                  role="img"
                  style="
                    --object-fit: {{ block.settings.image_fit }};
                    {% if block.settings.image_fit == 'cover' %} --image-corner-radius: {{ block.settings.image_corner_radius | append: '%' }} {% endif %}
                  "
                  {{ block.shopify_attributes }}
                  image-container
                >
                  {% if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
                  {% endif %}
                  {{
                    block.settings.marquee_image
                    | image_url: width: block.settings.marquee_image.width
                    | image_tag:
                      class: 'marquee-log image-responsive',
                      widths: '350,250,100',
                      sizes: sizes,
                      loading: 'lazy',
                      alt: block.settings.marquee_image.alt,
                      loading: loading,
                      fetchpriority: fetchpriority,
                      is: 'image-loading'
                  }}
                  {% if block.settings.link != blank %}</a>{% endif %}
                  {{
                    block.settings.marquee_image
                    | image_url: width: 5
                    | image_tag:
                      alt: block.settings.marquee_image.alt,
                      class: 'blur-image',
                      loading: loading,
                      fetchpriority: fetchpriority
                  }}
                </div>
              {% else %}
                <div
                  aria-label="Marquee Section image"
                  class="Marquee-tag__image"
                  id="marquee-image--{{ block.id }}"
                  role="img"
                >
                  {% if block.settings.link != blank -%}
                    <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
                  {% endif %}
                  {{ 'image' | placeholder_svg_tag }}
                  {% if block.settings.link != blank %}</a>{% endif %}
                </div>
              {% endif %}
            {% when 'content' %}
              <div
                aria-label="{{ block.settings.text }}"
                style="{% if block.settings.use_custom_color %} --color-text: {{ block.settings.color_custom }} {% endif %}"
                class="Marquee-tag marquee__text-color" {{ block.shopify_attributes }} >
                {% if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" target="{{ block.settings.link_target }}">
                {% endif %}
                <p class="marquee-text">{{ block.settings.text }}</p>
                {% if block.settings.link != blank %}</a>{% endif %}
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</div>
{% unless section.settings.full_width %}
  </div>
{% endunless %}
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'bottom' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-bottom"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
{% schema %}
{
  "name": "Scrolling content",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": true
    },
    {
      "type": "range",
      "label": "Desktop text size",
      "id": "marquee_text_size",
      "min": 12,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 12,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Scroll speed",
      "min": 3,
      "max": 30,
      "step": 1,
      "unit": "sec",
      "default": 18
    },

    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_top.label",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_bottom.label",
      "default": 12
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border",
      "options": [
        {
          "label": "Hide",
          "value": "hide"
        },
        {
          "label": "Full width",
          "value": "full_width"
        },
        {
          "label": "Fixed width",
          "value": "fixed_width"
        }
      ],
      "default": "hide"
    },
    {
      "type": "select",
      "id": "border_position",
      "label": "Border position",
      "options": [
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "both"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-3",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "type": "content",
      "name": "Content",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Promotion Text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "link_target",
          "label": "Open link in",
          "options": [
            {
              "label": "New tab",
              "value": "_blank"
            },
            {
              "label": "Same tab",
              "value": "_top"
            }
          ],
          "default": "_blank"
        },
        {
          "type": "checkbox",
          "id": "use_custom_color",
          "label": " Use custom color",
          "default": false
        },
        {
          "type": "color",
          "id": "color_custom",
          "default": "#000000",
          "label": "Custom color",
          "visible_if": "{{ block.settings.use_custom_color }}"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "marquee_image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_aspect_ratio",
          "label": "Image ratio",
          "options": [
            {
              "label": "Portrait (3:4)",
              "value": "portrait"
            },
            {
              "label": "Square (1:1)",
              "value": "square"
            },
            {
              "label": "Landscape (4:3)",
              "value": "landscape"
            }
          ],
          "default": "square"
        },
        {
          "type": "select",
          "id": "image_fit",
          "label": "Image fit",
          "default": "contain",
          "options": [
            {
              "value": "contain",
              "label": "Contain"
            },
            {
              "value": "cover",
              "label": "Cover"
            }
          ]
        },
        {
          "type": "range",
          "id": "image_corner_radius",
          "label": "Image corner radius",
          "min": 0,
          "max": 50,
          "unit": "%",
          "step": 1,
          "default": 0,
          "visible_if": "{{ block.settings.image_fit == 'cover' }}"
        },
        {
          "type": "range",
          "id": "icon_width",
          "label": "Width",
          "min": 50,
          "max": 200,
          "unit": "px",
          "step": 10,
          "default": 90
        },
        {
          "type": "range",
          "id": "icon_width_mobile",
          "label": "Mobile width",
          "min": 50,
          "max": 200,
          "unit": "px",
          "step": 10,
          "default": 50
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "link_target",
          "label": "Open link in",
          "options": [
            {
              "label": "New tab",
              "value": "_blank"
            },
            {
              "label": "Same tab",
              "value": "_top"
            }
          ],
          "default": "_blank"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling content",
      "category": "Banners",
      "blocks": [
        {
          "type": "content"
        },
        {
          "type": "image"
        },
        {
          "type": "content"
        },
        {
          "type": "image"
        }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["*"],
    "groups": ["footer"]
  }
}
{% endschema %}
