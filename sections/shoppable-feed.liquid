{{ 'section-shoppable-feed.css' | asset_url | stylesheet_tag }}
<script defer src="{{ 'section-shoppable-feed.js' | asset_url }}"></script>
{% liquid
  assign loading = 'eager'
  assign fetchpriority = 'auto'
  assign intersection = ''
  if section.index == 1
    assign fetchpriority = 'high'
  elsif section.index > 2
    assign loading = 'lazy'
    assign intersection = 'intersection-element'
  endif
  assign handle_present = false
  if section.settings.handle_name != blank or section.settings.handle_image != blank
    assign handle_present = true
  endif
%}

{% capture size %}
    (min-width:1336px) calc({{ settings.page_width | append: 'px' }} / {{ section.settings.columns_desktop }} - 45px), (min-width:767px) calc(100vw / 2 - 30px),calc(100vw - 30px)
{% endcapture %}

<style>
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | append: 'px' }}
    ;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | append: 'px' }}
    ;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | append: 'px' }}
      ;
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }}
      ;
    }
  }
</style>

{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'top' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-top"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
<shop-feed
  aria-label="{{ section.settings.heading }}"
  class="shoppable__feed section-{{ section.id }}-padding full-width-container  color-{{ section.settings.color_scheme }} overflow-hidden d-block"
  role="region"
  {% if section.settings.only_first_video -%}
    play-first-media
  {%- endif -%}
>
  <div class="container">
    <div class="d-flex d-flex-dir-c {{ section.settings.content_alignment | prepend : "text-" }} {{ section.settings.content_alignment | prepend : "align-item-" }} {% if handle_present -%} remove-header-bottom-spacing {%- endif  -%}">
      {% render 'section-heading', section: section %}
      {%- if handle_present -%}
        <animation-reveal
          aoi-type="fade-up"
          aoi-amount="0.2"
          aoi-delay="0.1"
          class="w-100"
        >
          <div class="shoppable__feed--social d-flex w-100 align-item-center mb-24 {{ section.settings.content_alignment | prepend : "justify-content-" }}">
            {%- if section.settings.handle_image -%}
              <div class="shoppable__feed--social--image position-relative overflow-hidden {{ section.settings.shape_type | prepend: "shape-" }}">
                <div class="image--aspectSize" image-container>
                  {%- if section.settings.handle_url != blank -%}
                    <a
                      href="{{ section.settings.handle_url }}"
                      target="{{ section.settings.link_target }}"
                    >
                  {%- endif -%}
                  {{
                    section.settings.handle_image
                    | image_url: width: 140
                    | image_tag:
                      widths: '140, 100',
                      sizes: '(max-width: 767) 100px',
                      alt: section.settings.handle_image.alt,
                      loading: loading,
                      fetchpriority: fetchpriority,
                      class: 'image-responsive object-fit-cover',
                      is: 'image-loading'
                  }}
                  {{
                    section.settings.handle_image
                    | image_url: width: 40
                    | image_tag:
                      alt: section.settings.handle_image.alt,
                      class: 'blur-image',
                      loading: loading,
                      fetchpriority: fetchpriority
                  }}
                  {%- if section.settings.handle_url != blank -%}</a>{%- endif -%}
                </div>
              </div>
            {%- endif -%}

            {%- if section.settings.handle_name -%}
              {%- if section.settings.handle_url != blank -%}
                <a
                  href="{{ section.settings.handle_url }}"
                  target="{{ section.settings.link_target }}"
                  class="shoppable__feed--social--handle__name fnt-16 text-decoration-underline text-color d-inline-block"
                >
                  {{ section.settings.handle_name }}
                </a>
              {%- else -%}
                <p class="shoppable__feed--social--handle__name fn-16 text-color">{{ section.settings.handle_name }}</p>
              {%- endif -%}
            {%- endif -%}
          </div>
        </animation-reveal>
      {%- endif -%}
    </div>
  </div>
  {% if section.blocks.size > 0 %}
    {% unless section.settings.full_width %}
      <div class="container">
    {% endunless %}
    <shoppable-carousel-component
      {{ intersection }}
      class="swiper d-block js-element"
      slide-layout-type="carousel"
      slide-pagination-type="progressbar"
      slide-per-view=" {% if section.settings.enable_centered_slides %} 1.4 {% else %} 1.2 {% endif %}"
      slide-responsive-breakpoints='{"600":{"slidesPerView": "2.2"},"1024":{"slidesPerView": "{{ section.settings.columns_desktop }}"}}'
      slide-speed="{{ settings.slide_duration }}"
      {% if section.settings.enable_centered_slides %}
        centered-slides
        slide-loop
        slide-slide-to-clicked-slide
      {% endif %}
    >
      <div class="swiper-container" main-slider>
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'media_post' %}
                <div
                  aria-label="Media post"
                  class="swiper-slide"
                >
                  <animation-reveal
                    aoi-type="fade-up"
                    aoi-amount="0"
                    aoi-delay="1"
                  >
                    <div class="shoppable-feed-slide">
                      {% render 'media-post',
                        block: block,
                        loopIndex: forloop.index,
                        media_loading_type: loading,
                        media_fetch_priority: fetchpriority,
                        media_aspect_ratio: section.settings.media_aspect_ratio,
                        media_overlay_background: section.settings.feed_overlay_color,
                        sizes: size,
                        index: forloop.index
                      %}
                    </div>
                  </animation-reveal>
                </div>
            {% endcase %}
          {% endfor %}
        </div>
      </div>
      {% unless section.settings.enable_centered_slides %}
        <div class="container{% unless section.settings.full_width %}p-0{% endunless %}">
          <div class="sliderControl">
            <div class="sliderProgressBar " slide-progress></div>
            <div class="d-flex sliderPagination">
              <!-- next / prev arrows -->
              <div class="" slide-prev>
                <div
                  aria-label="{{ 'accessibility.prev_slide_label' | t }}"
                  class="sliderPagination__prev"
                >
                  {% render 'icon', icon: 'left' %}
                </div>
              </div>
              <div class="" slide-next>
                <div
                  aria-label="{{ 'accessibility.next_slide_label' | t }}"
                  class="sliderPagination__next "
                >
                  {% render 'icon', icon: 'right' %}
                </div>
              </div>

              <!-- !next / prev arrows -->
            </div>
          </div>
        </div>
      {% endunless %}
    </shoppable-carousel-component>
    {% unless section.settings.full_width %}
      </div>
    {% endunless %}
  {% endif %}
</shop-feed>
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'bottom' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div
        class="spacer border-bottom"
      ></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}

{% schema %}
{
  "name": "Shoppable feed",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "options": [
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shoppable feed "
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading Tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Size",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "image_picker",
      "id": "handle_image",
      "label": "Profile Image"
    },
    {
      "type": "select",
      "id": "shape_type",
      "label": "Image Shape Type",
      "options": [
        {
          "label": "Square",
          "value": "square"
        },
        {
          "label": "Circle",
          "value": "circle"
        }
      ],
      "default": "circle"
    },
    {
      "type": "text",
      "id": "handle_name",
      "label": "Handle name",
      "default": "HandleName"
    },
    {
      "type": "url",
      "id": "handle_url",
      "label": "Handle url"
    },
    {
      "type": "select",
      "id": "link_target",
      "label": "Open link in",
      "options": [
        {
          "label": "New tab",
          "value": "_blank"
        },
        {
          "label": "Same tab",
          "value": "_top"
        }
      ],
      "default": "_top"
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Image ratio",
      "options": [
        {
          "label": "Square (1:1)",
          "value": "square"
        },
        {
          "label": "Portrait (3:4)",
          "value": "portrait"
        },
        {
          "label": "Portrait (9:16)",
          "value": "portrait-9-16"
        }
      ],
      "default": "portrait-9-16",
      "info": "Feed media will be cropped to fit the feed size. Feed preview is set to adapt to media by default"
    },
    {
      "type": "select",
      "label": "Show product",
      "id": "show_product",
      "options": [
        {
          "label": "Quick view",
          "value": "quick_view"
        },
        {
          "label": "Product page",
          "value": "product_page"
        }
      ]
    },
    {
      "type": "checkbox",
      "label": "Enable centered slides",
      "id": "enable_centered_slides",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "only_first_video",
      "label": "Play first video"
    },
    {
      "type": "select",
      "label": "Play on",
      "id": "play_media_on",
      "options": [
        {
          "label": "Hover",
          "value": "play_on_hover"
        },
        {
          "label": "Click",
          "value": "play_on_click"
        }
      ]
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "play_button_bg",
      "label": "Play button background",
      "default": "#000000",
      "alpha": true
    },
    {
      "type": "color",
      "id": "play_button_color",
      "label": "Play button",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "feed_text_color",
      "label": "Feed product text",
      "default": "#FFFFFF"
    },
    {
      "type": "color_background",
      "id": "feed_overlay_color",
      "label": "Feed overlay",
      "default": "linear-gradient(180deg, rgba(255, 255, 255, 0) 56%, rgba(0, 0, 0, 1) 96%)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_top.label",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_bottom.label",
      "default": 52
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border",
      "options": [
        {
          "label": "Hide",
          "value": "hide"
        },
        {
          "label": "Full width",
          "value": "full_width"
        },
        {
          "label": "Fixed width",
          "value": "fixed_width"
        }
      ],
      "default": "hide"
    },
    {
      "type": "select",
      "id": "border_position",
      "label": "Border position",
      "options": [
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "both"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Color scheme"
    }
  ],
  "blocks": [
    {
      "name": "Post",
      "type": "media_post",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "feed_image",
          "label": "Image",
          "info": "This image will be used as cover image if video is added"
        },
        {
          "type": "product_list",
          "id": "product_list",
          "label": "Products",
          "limit": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable feed",
      "category": "Products",
      "blocks": [
        {
          "type": "media_post"
        },
        {
          "type": "media_post"
        },
        {
          "type": "media_post"
        },
        {
          "type": "media_post"
        }
      ]
    }
  ]
}
{% endschema %}
