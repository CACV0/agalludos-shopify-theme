        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Your label"
        },
        {
          "type": "select",
          "id": "property_type",
          "label": "Type",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "checkbox",
              "label": "Checkbox"
            }
          ],
          "default": "text"
        },
        {
          "type": "text",
          "id": "label_placeholder",
          "label": "Placeholder",
          "default": "Enter your text here",
          "visible_if": "{{ block.settings.property_type == 'text' }}"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false,
          "info": "for text property, the customer must write a text;for checkbox, the customer must check it to add to cart"
        },
        {
          "type": "header",
          "content": "Text",
          "visible_if": "{{ block.settings.property_type == 'text' }}"
        },
        {
          "type": "checkbox",
          "id": "allow_long_text",
          "label": "Allow long text",
          "default": false,
          "visible_if": "{{ block.settings.property_type == 'text' }}"
