    {
      "type": "checkbox",
      "id": "mobile_enable_parallax",
      "label": "Enable parallax effect",
      "default": false
    },
    {
      "type": "range",
      "id": "mobile_media_gap",
      "label": "Gap",
      "min": 0,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "select",
      "id": "image_aspect_ratio_mobile",
      "label": "Image ratio",
      "options": [
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_1",
          "value": "portrait"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_2",
          "value": "square"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_3",
          "value": "adapt"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_4",
          "value": "landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_fit_mobile",
      "label": "Image fit",
      "options": [
        {
          "label": "t:settings_schema.global.collection_card.image_fit.option.contain",
          "value": "contain"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_fit.option.cover",
          "value": "cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "enable_swipe_on_mobile",
      "label": "Enable swipe on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Thumbnail"
    },
    {
      "type": "select",
      "id": "thumbnail_ratio",
      "label": "Thumbnail ratio",
      "options": [
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_1",
          "value": "portrait"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_2",
          "value": "square"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_3",
          "value": "adapt"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_4",
