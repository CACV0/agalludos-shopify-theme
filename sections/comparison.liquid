{{ 'section-comparison.css' | asset_url | stylesheet_tag }}
{% style %}
  /* CSS styles for padding */
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 | append: 'px' }};
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 | append: 'px' }};
  }

  /* Media query styles */
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | append: 'px' }};
      padding-bottom: {{ section.settings.padding_bottom | append: 'px' }};
    }
  }

  .comparison-{{ section.id }} .highlight-active {
    --column-border-color: {{ section.settings.highlighted_color_scheme.settings.border }};
    --column-text-color: {{ section.settings.highlighted_color_scheme.settings.text }};
    --column-fill-color: {{ section.settings.highlighted_color_scheme.settings.background }};
    --column-fill-gradient-color: {{ section.settings.highlighted_color_scheme.settings.background_gradient }};
    --divider-color: {{ section.settings.divider_color }};
    --color-button-background: {{ section.settings.highlighted_color_scheme.settings.primary_button }};
    --color-hover-button-label: {{ section.settings.highlighted_color_scheme.settings.hover_button_label }};
    --color-hover-button-background: {{ section.settings.highlighted_color_scheme.settings.hover_button_background }};
    --color-button-background-rgba: {{ section.settings.highlighted_color_scheme.settings.primary_button.rgba }};

    --color-button-text: {{ section.settings.highlighted_color_scheme.settings.on_primary_button }};

    --color-button-border: {{ section.settings.highlighted_color_scheme.settings.primary_button }};

    --color-button-background-outline: {{ section.settings.highlighted_color_scheme.settings.background }};

    --color-button-text-outline: {{ section.settings.highlighted_color_scheme.settings.secondary_button }};

    --color-button-border-outline: {{ section.settings.highlighted_color_scheme.settings.secondary_button }};
  }
{% endstyle %}

{% liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign content = section.settings.content
  assign heading_tag = section.settings.heading_tag
  assign loading = 'eager'
  assign fetchpriority = 'auto'
  assign intersection = ''
  if section.index == 1
    assign fetchpriority = 'high'
  elsif section.index > 2
    assign loading = 'lazy'
    assign intersection = 'intersection-element'
  endif
  assign product_images = section.blocks | where: 'type', 'table_value'
  assign table_heading_block = section.blocks | where: 'type', 'table_heading' | first
  assign heading_positions = ''
  for i in (1..10)
    assign heading_key = 'heading_' | append: i
    assign custom_icon = 'custom_icon_' | append: i
    if table_heading_block.settings[heading_key] != blank or table_heading_block.settings[custom_icon] != blank
      assign heading_positions = heading_positions | append: i | append: ','
    endif
  endfor
  assign full_width_heading_container = false
  assign as_image = false
  for block in product_images
    if block.settings.product == blank and block.settings.image == blank
      assign full_width_heading_container = true
    else
      assign as_image = true
      assign full_width_heading_container = false
      break
    endif
  endfor
  assign heading_positions = heading_positions | split: ','
%}
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'top' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div class="spacer border-top"></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
<div
  class="comparison comparison-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }}"
  style="--desktop-table-border-color:var(--color-border-rgba)"
>
  <div class="container">
    <animation-reveal
      aoi-type="fade-up"
      aoi-amount="0.2"
      class="comparison__header-container {% unless full_width_heading_container %} d-none {% else %} full-width-container {% endunless %}"
    >
      {% if subheading != blank %}
        <p class="mb-2">{{ subheading }}</p>
      {% endif %}
      {% if heading != blank %}
        <{{ heading_tag }} class="{{ section.settings.style }} mb-16">{{ heading }}</{{ heading_tag }}>
      {% endif %}
      <div class="section__subContent">
        <div class="RTE-content">
          {{ content }}
        </div>
      </div>
    </animation-reveal>
    <comparison-component
      {{ intersection }}
      slide-layout-type="carousel"
      slide-no-center
      slide-per-view="2.2"
      space-between="0"
      slide-speed="{{ settings.slide_duration }}"
      slide-grab-cursor="{{ settings.enable_grab_cursor }}" 
      
    >
      <div class="comparison__container d-flex comparison__header-image-container">
        <div class="comparison__grid-item comparison__header {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}">
          <animation-reveal
            aoi-type="fade-up"
            aoi-amount="0.2"
            aoi-delay="0.1"
            class="comparison__header-container {% if full_width_heading_container %} d-none {% endif %}"
          >
            {% if subheading != blank %}
              <p class="mb-2">{{ subheading }}</p>
            {% endif %}
            {% if heading != blank %}
              <{{ heading_tag }} class="h2 mb-16">{{ heading }}</{{ heading_tag }}>
            {% endif %}
            <div class="RTE-content">
              {{ content }}
            </div>
          </animation-reveal>
          <div class="d-flex sliderPagination sliderControl">
            <!-- next / prev arrows -->
            <div
              aria-label="{{ 'accessibility.prev_slide_label' | t }}"
              role="button"
              slide-prev
            >
              <div class="sliderPagination__prev collectionControl__prev">
                {% render 'icon', icon: 'left' %}
              </div>
            </div>
            <div
              aria-label="{{ 'accessibility.next_slide_label' | t }}"
              role="button"
              slide-next
            >
              <div class="sliderPagination__next collectionControl__next">
                {% render 'icon', icon: 'right' %}
              </div>
            </div>

            <!-- !next / prev arrows -->
          </div>
        </div>
        {% if product_images.size > 0 %}
          <div class="comparison__grid-item comparison__image-slider js-element {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}">
            <div
              class="swiper-container"
              main-slider
              slide-responsive-breakpoints='{"320":{"slidesPerView": "{% if product_images.size > 2 %} 2.15 {% else %} 2 {% endif %}","spaceBetween": 0 },"768":{"slidesPerView":"2","spaceBetween": 20 },"992":{"slidesPerView":"{{ section.settings.number_of_column }}", "spaceBetween": 20}}'
            >
              <div class="swiper-wrapper">
                {% for block in product_images %}
                  {% liquid
                    if section.settings.enable_highlight
                      case section.settings.badge_position
                        when 'first'
                          assign position = 1
                        when 'two'
                          assign position = 2
                        when 'three'
                          assign position = 3
                      endcase
                    endif
                  %}
                  {% assign prevelement = position | minus: 1 %}
                  {% if block.settings.product != blank
                    or block.settings.image != blank
                    or block.settings.heading != blank
                  %}
                    <div
                      {{ block.shopify_attributes }}
                      class="swiper-slide  {% if prevelement == forloop.index %} highlight-prev-element {% endif %} {% if position == forloop.index  %} highlight-active {% endif %}"
                    >
                      {% render 'comparison-product-image',
                        block: block,
                        loading: loading,
                        fetchpriority: fetchpriority,
                        as_image: as_image,
                        forloopIndex: forloop.index,
                        position: position
                      %}
                    </div>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          <noscript>
            <div class="comparison__grid-item h-100 w-100 comparison__image-slider {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}">
              <div
                class="swiper"
                slide-responsive-breakpoints='{"320":{"slidesPerView": "{% if product_images.size > 2 %} 2.15 {% else %} 2 {% endif %}","spaceBetween": 0 },"768":{"slidesPerView":"2", "spaceBetween": 20 },"992":{"slidesPerView":"{{ section.settings.number_of_column }}", "spaceBetween": 20}}'
              >
                <div class="swiper-wrapper">
                  {% for block in product_images %}
                    {% liquid
                      if section.settings.enable_highlight
                        case section.settings.badge_position
                          when 'first'
                            assign position = 1
                          when 'two'
                            assign position = 2
                          when 'three'
                            assign position = 3
                        endcase
                      endif
                    %}
                    {% assign prevelement = position | minus: 1 %}
                    {% if block.settings.product != blank
                      or block.settings.image != blank
                      or block.settings.heading != blank
                    %}
                      <div
                        {{ block.shopify_attributes }}
                        class="swiper-slide  {% if prevelement == forloop.index %} highlight-prev-element {% endif %} {% if position == forloop.index  %} highlight-active {% endif %}"
                      >
                        {% render 'comparison-product-image', block: block, as_image: as_image %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </noscript>
        {% endif %}
      </div>
      <animation-reveal
        aoi-type="fade-in"
        aoi-amount="0.2"
        aoi-duration="0.7"
        class="comparison__table-header-value-container mobile-color-{{ section.settings.mobile_tabel_color_scheme }}"
        style="--desktop-table-background: {{ section.settings.desktop_background_color }}; --desktop-heading-divider-color: {{ section.settings.desktop_divider_color }};"
      >
        <div class="comparison__container d-flex  ">
          <ul
            class="comparison__grid-item {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}"
            style="--color-text: {{ section.settings.desktop_heading_color }};"
          >
            {% for i in (1..10) %}
              {% assign heading = 'heading_' | append: i %}
              {% assign custom_icon = 'custom_icon_' | append: i %}
              {% if table_heading_block.settings[heading] != blank
                or table_heading_block.settings[custom_icon] != blank
              %}
                <li class="comparison__table-heading" table-row-heading>
                  {% unless table_heading_block.settings[custom_icon] == blank %}
                    {{
                      table_heading_block.settings[custom_icon]
                      | image_url: width: table_heading_block.settings[custom_icon].width
                      | image_tag:
                        class: 'comparison_icon',
                        widths: '300,200,100,500',
                        alt: table_heading_block.settings[custom_icon].alt,
                        loading: loading,
                        fetchpriority: fetchpriority
                    }}
                  {% endunless %}
                  {% unless table_heading_block.settings[heading] == blank %}
                    <{{ table_heading_block.settings.heading_tag }} class="fnt-16 fnt-body fnt-body-weight-bold m-0 {{ table_heading_block.settings.style }}">
                      {{ table_heading_block.settings[heading] }}
                    </{{ table_heading_block.settings.heading_tag }}>
                  {% endunless %}
                </li>
              {% endif %}
            {% endfor %}
          </ul>

          <div class="comparison__grid-item js-element {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}">
            <div
              class="swiper-container overflow-hidden comparison__table-slider"
              main-slider
              slide-responsive-breakpoints='{"320":{"slidesPerView": "{% if product_images.size > 2 %} 2.15 {% else %} 2 {% endif %}","spaceBetween": 0 },"768":{"slidesPerView":"2", "spaceBetween": 20 },"992":{"slidesPerView":"{{ section.settings.number_of_column }}", "spaceBetween": 20}}'
            >
              <div class="swiper-wrapper">
                {% for block in product_images %}
                  {% liquid
                    if section.settings.enable_highlight
                      case section.settings.badge_position
                        when 'first'
                          assign position = 1
                        when 'two'
                          assign position = 2
                        when 'three'
                          assign position = 3
                      endcase
                    endif
                  %}
                  {% if block.settings.product != blank
                    or block.settings.image != blank
                    or block.settings.heading != blank
                  %}
                    {% assign prevelement = position | minus: 1 %}

                    {% render 'comparison-table-values',
                      prevelement: prevelement,
                      forloopIndex: forloop.index,
                      block: block,
                      position: position,
                      heading_positions: heading_positions,
                      table_heading_block: table_heading_block
                    %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          </div>
          <noscript class="table-values-no-js">
            <div class="comparison__grid-item w-100 h-100 {% if section.settings.number_of_column == "2"%} comparison__grid-item--two_columns {% endif %}">
              <div
                class="swiper overflow-hidden comparison__table-slider"
                slide-responsive-breakpoints='{"320":{"slidesPerView": "{% if product_images.size > 2 %} 2.15 {% else %} 2 {% endif %}","spaceBetween": 0 },"768":{"slidesPerView":"2", "spaceBetween": 20 },"992":{"slidesPerView":"{{ section.settings.number_of_column }}", "spaceBetween": 20}}'
              >
                <div class="swiper-wrapper">
                  {% for block in product_images %}
                    {% liquid
                      if section.settings.enable_highlight
                        case section.settings.badge_position
                          when 'first'
                            assign position = 1
                          when 'two'
                            assign position = 2
                          when 'three'
                            assign position = 3
                        endcase
                      endif
                    %}
                    {% if block.settings.product != blank
                      or block.settings.image != blank
                      or block.settings.heading != blank
                    %}
                      {% assign prevelement = position | minus: 1 %}
                      {% render 'comparison-table-values',
                        prevelement: prevelement,
                        forloopIndex: forloop.index,
                        block: block,
                        heading_positions: heading_positions
                      %}
                    {% endif %}
                  {% endfor %}
                </div>
              </div>
            </div>
          </noscript>
        </div>
      </animation-reveal>
    </comparison-component>
  </div>
</div>
{% unless section.settings.border_size == 'hide' %}
  {% if section.settings.border_position == 'both' or section.settings.border_position == 'bottom' %}
    {% unless section.settings.border_size == 'full_width' %}
      <div class="container">
    {% endunless %}
    <div class="spacer-wrapper color-{{ section.settings.color_scheme }}">
      <div class="spacer border-bottom"></div>
    </div>
    {% unless section.settings.border_size == 'full_width' %}
      </div>
    {% endunless %}
  {% endif %}
{% endunless %}
{% schema %}
{
  "name": "Comparison",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparison chart"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": "Size",
      "options": [
        {
          "label": "H1",
          "value": "h1"
        },
        {
          "label": "H2",
          "value": "h2"
        },
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>Add products or brands to compare between the features they provide.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy",
      "label": "Show quick buy",
      "default":false
    },
    {
      "type": "select",
      "id": "quick_view_position",
      "label": "Quick buy button position",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "bottom",
      "visible_if": "{{ section.settings.show_quick_buy }}"
    },
    {
      "type": "checkbox",
      "id": "show_quick_buy_on_mobile",
      "label": "Show quick buy in mobile",
      "default":true,
      "visible_if": "{{ section.settings.show_quick_buy }}"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "t:settings_schema.global.collection_card.image_ratio.label",
      "options": [
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_1",
          "value": "portrait"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_2",
          "value": "square"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_3",
          "value": "adapt"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_ratio.option.label_4",
          "value": "landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "t:settings_schema.global.collection_card.image_fit.label",
      "options": [
        {
          "label": "t:settings_schema.global.collection_card.image_fit.option.contain",
          "value": "contain"
        },
        {
          "label": "t:settings_schema.global.collection_card.image_fit.option.cover",
          "value": "cover"
        }
      ],
      "default": "contain"
    },
    {
      "type": "color",
      "id": "card_image_background",
      "label": "Image background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Column"
    },
    {
      "type": "select",
      "id": "number_of_column",
      "label": "Number of columns on desktop",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "3"
    },
    {
      "type": "text_alignment",
      "id": "column_text_alignment",
      "label": "Column text alignment",
      "default": "center"
    },
    {
      "type": "color_scheme",
      "label": "Desktop column background color",
      "id": "desktop_column_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Table"
    },
    {
      "type": "color",
      "label": "Desktop heading color",
      "id": "desktop_heading_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "label": "Mobile heading color",
      "id": "mobile_heading_color",
      "default": "#000000"
    },
    {
      "type": "color",
      "label": "Desktop table background color",
      "id": "desktop_background_color",
      "default": "#D8D8D8"
    },
    {
      "type": "color",
      "label": "Desktop heading divider color",
      "id": "desktop_divider_color",
      "default": "#ffffff"
    },
    {
      "type": "color_scheme",
      "label": "Mobile table color scheme",
      "id": "mobile_tabel_color_scheme",
      "default": "scheme_1"
    },
    {
      "type": "header",
      "content": "Highlight"
    },
    {
      "type": "checkbox",
      "id": "enable_highlight",
      "label": "Enable highlight"
    },
    {
      "type": "select",
      "label": "Position",
      "id": "badge_position",
      "info": "Choose which column you would like to highlight",
      "options": [
        {
          "label": "First",
          "value": "first"
        },
        {
          "label": "Two",
          "value": "two"
        },
        {
          "label": "Three",
          "value": "three"
        }
      ],
      "default": "first",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "info": "Leave the field empty to disable badge",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "select",
      "label": "Icon style",
      "id": "icon_style",
      "options": [
        {
          "label": "Heart",
          "value": "comparison-heart"
        },
        {
          "label": "Diamond",
          "value": "comparison-diamond"
        },
        {
          "label": "Star",
          "value": "comparison-star"
        },
        {
          "label": "Smiley",
          "value": "comparison-smailey"
        }
      ],
      "default": "comparison-star",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "color",
      "id": "badge_text_icon_color",
      "label": "Badge Text/Icon color",
      "default": "#ffffff",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "color",
      "id": "badge_background_color",
      "label": "Badge background color",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "color_scheme",
      "id": "highlighted_color_scheme",
      "default": "scheme-1",
      "label": "Highlight color",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#000000",
      "visible_if": "{{ section.settings.enable_highlight }}"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_top.label",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:settings_schema.global.section.padding.settings.padding_bottom.label",
      "default": 52
    },
    {
      "type": "select",
      "id": "border_size",
      "label": "Border",
      "options": [
        {
          "label": "Hide",
          "value": "hide"
        },
        {
          "label": "Full width",
          "value": "full_width"
        },
        {
          "label": "Fixed width",
          "value": "fixed_width"
        }
      ],
      "default": "hide"
    },
    {
      "type": "select",
      "id": "border_position",
      "label": "Border position",
      "options": [
        {
          "label": "Both",
          "value": "both"
        },
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "both"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Section color"
    }
  ],
  "blocks": [
    {
      "name": "Table value",
      "type": "table_value",
      "limit": 6,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Custom heading"
        },
        {
          "type": "select",
