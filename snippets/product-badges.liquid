<script defer src="{{ 'product-badges.js' | asset_url }}"></script>

{%- capture section_bg -%}{{ section.settings.color_scheme.settings.background }}{%- endcapture -%}

{%- for i in (1..6) -%}
  {%- assign badge_scheme_id = 'color_scheme_badge_' | append: i -%}
  {%- capture badge_bg -%}{{ block.settings[badge_scheme_id].settings.background }}{%- endcapture -%}
  {%- if badge_bg == 'rgba(0,0,0,0)' or badge_bg == 'transparent' or badge_bg == blank -%}
    {%- assign no_padding_val = true -%}
  {%- elsif section_bg == badge_bg -%}
    {%- if section.settings.color_scheme.settings.background_gradient == blank -%}
      {%- assign no_padding_val = true -%}
    {%- else -%}
      {%- assign no_padding_val = false -%}
    {%- endif -%}
  {%- else -%}
    {%- assign no_padding_val = false -%}
  {%- endif -%}
  {%- case i -%}
    {%- when 1 -%}{%- assign no_padding_1 = no_padding_val -%}
    {%- when 2 -%}{%- assign no_padding_2 = no_padding_val -%}
    {%- when 3 -%}{%- assign no_padding_3 = no_padding_val -%}
    {%- when 4 -%}{%- assign no_padding_4 = no_padding_val -%}
    {%- when 5 -%}{%- assign no_padding_5 = no_padding_val -%}
    {%- when 6 -%}{%- assign no_padding_6 = no_padding_val -%}
  {%- endcase -%}
{%- endfor -%}

<div class="badge-container">
  <badge-component id="{{ block.id | prepend: 'shopify-section-' }}" target-portal-element="#portal">
    <ul
      class="
        product-badges product-badges--style-{{ block.settings.badge_stack_style }}
        {% if block.settings.enable_stack and block.settings.badge_stack_style == 'wrap' %} product-stack-content {% endif %}
      "
      style="padding-bottom: {{ block.settings.block_bottom_spacing | append: 'px' }}"
    >
      {% if block.settings.enable_badge_1 %}
        <li>
          <button
            class="product-badges__item d-v-center color-{{ block.settings.color_scheme_badge_1 }}" style="--badges-padding: {% if no_padding_1 %} 0 {% else %}8px 16px{% endif %};"
            {% if block.settings.content_1 != blank or block.settings.page_1 != blank %}
              triger-drawer-button
            {% endif %} 
          >
            {% liquid
              case block.settings.icon_style_1
                when 'question'
                  assign icon = 'icon-question'
                when 'leaf'
                  assign icon = 'icon-leaf'
                when 'globe'
                  assign icon = 'icon-globe'
                when 'box'
                  assign icon = 'icon-box'
                when 'heart'
                  assign icon = 'icon-heart'
                when 'gift'
                  assign icon = 'icon-gift'
                when 'smile'
                  assign icon = 'icon-smile'
                when 'thumb'
                  assign icon = 'icon-thumb'
                when 'back'
                  assign icon = 'icon-back'
                when 'secure'
                  assign icon = 'icon-secure'
                when 'card'
                  assign icon = 'icon-card'
                when 'tags'
                  assign icon = 'icon-tags'
                when 'diamond'
                  assign icon = 'icon-diamond'
                when 'check'
                  assign icon = 'icon-circle-tick'
                when 'arrow'
                  assign icon = 'circle-with-arrow'
                when 'star'
                  assign icon = 'icon-star-sm'
                when 'vehicle'
                  assign icon = 'icon-vehicle'
                when 'none'
                  assign icon = 'none'
              endcase
            %}

            {% if block.settings.custom_image_1 != blank %}
              <span
                class="product-badge"
              >
                {{
                  block.settings.custom_image_1
                  | image_url: width: block.settings.custom_image_1.width
                  | image_tag: widths: '32,64', sizes: '32px', alt: block.settings.custom_image_1.alt, class: 'product-badge-icon'
                }}
              </span>
            {% elsif icon != 'none' %}
              <span
                class="product-badge"
              >
                {%- render 'icon' with icon,
                  width: '24',
                  height: '24',
                  circleColor: 'var(--color-icon)',
                  pathColor: 'var(--color-icon)'
                -%}
              </span>
            {% endif %}
            <div class="product-badge-text">
              <span>{{ block.settings.heading_1 }}</span>
              {% if block.settings.enable_stack and block.settings.badge_stack_style == 'wrap' %}
                {% if block.settings.page_1 != blank or block.settings.content_1 != blank %}
                  <span
                    class="caret-right-icon"
                    style="--color-icon:{{ block.settings.color_scheme_badge_1.settings.navigation_arrow }}"
                  >
                    {% render 'icon' with 'caret-right-icon' %}
                  </span>
                {% endif %}
              {% endif %}
            </div>
            {% if block.settings.content_1 != blank or block.settings.page_1 != blank %}
              <div class="product-badge-content visually-hidden" drawer-content>
                <h3>{{ block.settings.heading_1 }}</h3>
                <div class="RTE-content">
                  {{ block.settings.content_1 }}
                  {{ block.settings.page_1.content }}
                </div>
              </div>
              {% if block.settings.badge_stack_style == 'vertical'
                or block.settings.enable_stack == false
                and block.settings.badge_stack_style == 'wrap'
              %}
                <span
                  class="caret-right-icon"
                  style="--color-icon:{{ block.settings.color_scheme_badge_1.settings.navigation_arrow }}"
                >
                  {% render 'icon' with 'caret-right-icon' %}
                </span>
              {% endif %}
            {% endif %}
          </button>
        </li>
