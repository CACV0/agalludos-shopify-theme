{%- liquid

  assign sel = product.selected_variant
  if sel != blank
    if sel.available
      assign buy_state = 'available'
    else
      assign buy_state = 'sold_out'
    endif
  else
    assign sofav = product.selected_or_first_available_variant
    assign selected_title = ''
    for opt in product.options_with_values
      if forloop.first
        assign selected_title = opt.selected_value
      else
        assign selected_title = selected_title | append: ' / ' | append: opt.selected_value
      endif
    endfor
    if sofav.title == selected_title
      if sofav.available
        assign buy_state = 'available'
      else
        assign buy_state = 'sold_out'
      endif
    else
      assign buy_state = 'unavailable'
    endif
  endif

  assign is_product_available = false
  if buy_state == 'available'
    assign is_product_available = true
  endif
-%}

<div class="d-flex d-flex-dir-c sticky-add-to-cart__flex__wrap">
  <div class="sticky-add-to-cart__leftBlock" stikcy-add-to-cart-button-content>
    {% comment %} Product form {% endcomment %}

    <!-- form content -->
    {% if is_product_available %}
      {% unless section.settings.sticky_add_to_cart_style == 'bar' %}
        <button
          class="btn btn--fill text-upper sticky-icon-button"
          toggle-element="cart-drawer"
          form="{{ form_id }}"
          aria-label="{{ 'products.product.sticky_add_to_cart.add_to_cart' | t }}"
          type="button"
          add-to-cart-button
        >
          <div class="btn--preloader">
            <div class="btn--preloader--circular">
              <div class="checkmark draw"></div>
            </div>
          </div>
          <div class="btn--text">
            {% render 'icon', icon: 'plus', color_var: 'var(--color-button-text)' %}
          </div>
        </button>
      {% else %}
        <button
          class="btn btn--fill text-upper"
          toggle-element="cart-drawer"
          form="{{ form_id }}"
          type="button"
          add-to-cart-button
        >
          <div class="placeholder-text">
            <span>
              {% if settings.currency_code_enabled %}
                {{ product.selected_or_first_available_variant.price | money_with_currency }}
              {% else %}
                {{ product.selected_or_first_available_variant.price | money }}
              {% endif %}
            </span>
            - {{ 'products.product.sticky_add_to_cart.add_to_cart' | t }}
          </div>
          <div class="btn--preloader">
            <div class="btn--preloader--circular">
              <div class="checkmark draw"></div>
            </div>
          </div>
          <div class="btn--text">
            <span>
              {% if settings.currency_code_enabled %}
                {{ product.selected_or_first_available_variant.price | money_with_currency }}
              {% else %}
                {{ product.selected_or_first_available_variant.price | money }}
              {% endif %}
            </span>
            - {{ 'products.product.sticky_add_to_cart.add_to_cart' | t }}
          </div>
        </button>
      {% endunless %}

    {%- else -%}
      {% unless section.settings.sticky_add_to_cart_style == 'bar' %}
        <button
          class="btn btn--fill text-upper disable sticky-icon-button"
          sticky-icon-button
          aria-label="{%- if buy_state == 'unavailable' -%}{{ 'products.product.unavailable' | t }}{%- else -%}{{ 'cart.button_out_of_stock' | t }}{%- endif -%}"
          type="button"
          disabled
        >
          {% render 'icon', icon: 'plus', color_var: 'var(--color-button-text)' %}
        </button>
      {% else %}
        <button class="btn btn--fill text-upper disable" sticky-bar-button type="button" disabled>
          {%- if buy_state == 'unavailable' -%}
            {{ 'products.product.unavailable' | t }}
          {%- else -%}
            {{ 'cart.button_out_of_stock' | t }}
          {%- endif -%}
        </button>
      {% endunless %}
    {% endif %}
  </div>
</div>

{% comment %} Form {% endcomment %}
