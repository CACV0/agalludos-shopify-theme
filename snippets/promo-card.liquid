{% doc %}
  Renders HTML for Promo card

  @param {object} section - section settings
  @param {object} block - section block settings
  @param {string} promoClass - class name to swiper-slide [optional]
  @param {boolean} enable_mobile_height - promo card height enabled or not for mobile [optional]
  @param {string} loading - loading for image whether it is lazy or eager
  @param {string} fetchpriority - priority for image whether it it auto or high
{% enddoc %}

{% liquid
  assign ratio = false
  if settings.image_aspect_ratio == 'adapt'
    if block.settings.promo_image
      assign ratio = block.settings.promo_image.aspect_ratio
    else
      assign ratio = 1
    endif
  endif
%}
<div
  class="promo-card h-auto {{ promoClass }}"
  {% if section.settings.columns_mobile == '1' and enable_mobile_height %}
    style="--mobile-height:{{ block.settings.image_height | append:'vh' }};"
  {% endif %}
>
  <div class="promo-card__item">
    {% capture overlay_background %}
      {% if block.settings.promo_overlay_style == 'gradient' %}
        {{ block.settings.promo_background_gradient }}
      {% else %}
        {{ block.settings.promo_background_solid }}
      {% endif %} 
    {% endcapture %}
    {% if block.settings.promo_link %}
      <a
        class="promo-card-link h-100"
        target="{{block.settings.promo_link_tab}}"
        href="{{block.settings.promo_link}}"
      >
    {%- else -%}
      <div
        class="promo-card-link h-100"
        {% if block.settings.promo_image.alt %}
          aria-label="{{ block.settings.promo_image.alt }}"
        {% endif %}
      >
    {% endif %}
    <div
      class="promo-card__content-wrapper text-{{ block.settings.promo_content_alignment }} text-{{ block.settings.promo_content_alignment_mobile }}-md margin-{{ block.settings.promo_content_alignment }} margin-{{ block.settings.promo_content_alignment_mobile }}-md"
      style="--vertical-alignment:{{ block.settings.promo_content_position}};--mobile-vertical-alignment:{{ block.settings.promo_content_position_mobile}}; "
    >
      <div class="w-100" style="--color-text:{{ block.settings.promo_text_color }}">
        <{{ block.settings.promo_heading_tag }} class="{{ block.settings.promo_heading_style }} mt-0">
          {{- block.settings.promo_heading -}}
        </{{ block.settings.promo_heading_tag }}>
        {{ block.settings.promo_content }}
      </div>
    </div>
    <div
      class="promo-card__image-wrapper"
      style="
        --promo-background-overlay:{{ overlay_background }};
        {% if ratio and block.settings.promo_video == blank %}--aspect-ratio:{{ ratio }} {% elsif ratio and block.settings.promo_video != blank  %}--aspect-ratio:1{% endif %}
      "
      image-container
    >
      {%- capture image_class -%}
          aspect-ratio-{{ settings.image_aspect_ratio }} object-fit-{{ block.settings.image_fit }} set-100-percentage-size-media product_featured_image primary_image
          {% if block.settings.promo_link %} card-hover {% endif %}
        {%- endcapture -%}
      {% if block.settings.promo_video == blank %}
        {% if block.settings.promo_image != blank %}
          {{
            block.settings.promo_image
            | image_url: width: block.settings.promo_image.width
            | image_tag:
              widths: '500,600',
              sizes: '(min-width: 1400px) 314px, (min-width: 1220px) 247px, (min-width: 1000px) 365px, (min-width: 780px) 261px, (min-width: 580px) 313px, (min-width: 480px) calc(67.5vw - 51px), calc(67.5vw - 23px)',
              alt: block.settings.promo_image.alt,
              class: image_class,
              loading: loading,
              fetchpriority: fetchpriority,
              is: 'image-loading'
          }}
          {{
            block.settings.promo_image
            | image_url: width: 40
            | image_tag:
              alt: block.settings.promo_image.alt,
              class: 'blur-image',
              loading: loading,
              fetchpriority: fetchpriority
          }}
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: image_class }}
        {% endif %}
      {%- else -%}
        <default-player
          class="d-block custom__player__element position-relative set-100-percentage-size-media"
          watch-element
          data-media-type="video"
          media-autoplay
          role="group"
          aria-label="Video Player"
        >
          <video
            class="aspect-ratio-{{ settings.image_aspect_ratio }} set-100-percentage-size-media product_featured_image primary_image"
            preload="metadata"
            poster="false"
            webkit-playsinline
            playsinline
            muted
            autoplay
            loop
            {% if block.settings.promo_video.alt %}
              aria-label="{{ block.settings.promo_video.alt}}"
            {% endif %}
          >
            {%- for source in block.settings.promo_video.sources -%}
              <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
            {%- endfor -%}
            Your browser does not support the video tag.
          </video>
          <div
            class="set-100-percentage-size-media promo-card__preview-element position-absolute "
            video-preview-elements
          >
            {% liquid
              assign cover_image = block.settings.promo_image | default: block.settings.promo_video.preview_image
            %}
            {% if cover_image != blank %}
              {{
                cover_image
                | image_url: width: cover_image.width
                | image_tag:
                  widths: '500,600',
                  sizes: '(min-width: 1400px) 314px, (min-width: 1220px) 247px, (min-width: 1000px) 365px, (min-width: 780px) 261px, (min-width: 580px) 313px, (min-width: 480px) calc(67.5vw - 51px), calc(67.5vw - 23px)',
                  alt: cover_image.alt,
                  class: 'set-100-percentage-size-media product_featured_image primary_image',
                  loading: loading,
                  fetchpriority: fetchpriority
              }}
            {% endif %}
          </div>
        </default-player>
      {% endif %}
    </div>
    {% if block.settings.promo_link %}
      </a>
    {% else %}
      </div>
    {% endif %}
  </div>
</div>
