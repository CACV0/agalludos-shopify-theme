{% comment %}
  Snippet that will handle product-media
  3d Model Viewer Document
  https://modelviewer.dev/docs/#loading
  List of variables used
  product_media - {{ Array }} Product Media related data
{% endcomment %}

{% liquid
  assign medias = product_media
  unless template.name == 'product'
    assign medias = product_media | where: 'media_type', 'image'
  endunless
  if show_only_images
    assign medias = product_media | where: 'media_type', 'image'
  endif
  assign layout_class = 'swiper-slide'
  if layout_type == 'grid' or layout_type == 'grid-with-main-media'
    assign layout_class = 'grid__layout__item'
  endif
  assign show_media = true
  if show_only_images
    if product_first_media.media_type == 'image'
      assign show_media = true
    else
      assign show_media = false
    endif
  endif
  assign preview_image_flag = render_preview_image | default: false
%}

{%- if onboarding -%}
  {% render 'media', media: media, onboarding: onboarding %}
{%- elsif select_variant_to_show != null and render_variant_images -%}
  {% for image in select_variant_to_show.images.value %}
    <div class="{{ layout_class }}">
      {% render 'media',
        media: image,
        show_preview_image: preview_image_flag,
        media_autoplay: media_autoplay,
        layout_type: layout_type,
        add_media_aspect_ratio: false,
        add_media_aspect_ratio_mobile: false,
        is_thumbnail: true
      %}
    </div>
  {% endfor %}
{% else %}
  {% if show_media %}
    <div class="{{ layout_class }}">
      {% render 'media',
        media: product_first_media,
        show_preview_image: preview_image_flag,
        media_autoplay: media_autoplay,
        layout_type: layout_type,
        add_media_aspect_ratio: false,
        add_media_aspect_ratio_mobile: false,
        is_thumbnail: true
      %}
    </div>
  {% endif %}
  {% for media in medias %}
    {% if media.id != product_feature_media_id %}
      {%- assign preview_image_flag = render_preview_image | default: false -%}
      <div class="{{ layout_class }}">
        {% render 'media',
          media: media,
          show_preview_image: preview_image_flag,
          media_autoplay: media_autoplay,
          layout_type: layout_type,
          add_media_aspect_ratio: false,
          add_media_aspect_ratio_mobile: false,
          is_thumbnail: true
        %}
      </div>
    {% endif %}
  {% endfor %}
{%- endif -%}
