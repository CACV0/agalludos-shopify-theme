{% comment %}
  Params Used:
  product: @object - Gets you which product object
{% endcomment %}

{%- liquid
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif
-%}

{% capture image %}
  {% comment %} Image {% endcomment %}
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: product.featured_media.width
        | image_tag:
          widths: '141, 57',
          sizes: '(max-width: 767) 57px',
          alt: product.featured_media.alt,
          loading: 'lazy',
          class: 'image-responsive object-fit-contain'
      }}
    {% else %}
      <div class="product-cart-no-image-container">
        <div class="product-cart-no-image"></div>
      </div>
    {%- endif -%}
{% endcapture %}

{% capture title %}
  {{ product.title | truncatewords: 6 }}
{% endcapture %}

{% if section.settings.show_product == 'quick_view' %}
  <product-card product-handle="{{ product.handle }}" product-id="{{ product.selected_or_first_available_variant.id }}">
    {% form 'product', product, class: 'product-card-item__form' %}
      <div class="d-flex shoppable__feed--product">
        <div class="position-relative shoppable__feed--product--image">
          <button
            class="cursor-pointer button-rest-styles image--aspectSize"
            type="submit"
            toggle-element="options-drawer"
          >
            <div class="loader-container" product-loader>
              <div class="preloader-circle"></div>
            </div>
            {{ image }}

            {% comment %} </div> {% endcomment %}
          </button>
        </div>
        <div class="w-100 shoppable__feed--product--info d-flex d-flex-dir-c">
          {% comment %} Title {% endcomment %}
          <input
            name="id"
            type="hidden"
            value="{{ product.first_available_variant.id }}"
          >
          <input
            name="quantity"
            type="hidden"
            value="1"
          >
          <button
            class="cursor-pointer fnt-16 button-rest-styles text-color"
            toggle-element="options-drawer"
            type="submit"
          >
            {{ title }}
          </button>
          <!-- form content -->

          <div class="d-flex justify-content-space-btw mt-12 fnt-14 text-color">
            {% comment %} Price {% endcomment %}
            {% render 'price', product: product, on_sale: on_sale, hide_percentage_off: true, use_variant: true %}
            {% comment %} Product form {% endcomment %}
          </div>
        </div>
      </div>
    {% endform %}
  </product-card>
{% else %}
  <div class="d-flex shoppable__feed--product">
    <div class="position-relative shoppable__feed--product--image">
      <a
        href="{{ product.url }}"
        class="cursor-pointer button-rest-styles image--aspectSize"
        type="submit"
        toggle-element="options-drawer"
      >
        <div class="loader-container" product-loader>
          <div class="preloader-circle"></div>
        </div>
        {{ image }}

        {% comment %} </div> {% endcomment %}
      </a>
    </div>
    <div class="w-100 shoppable__feed--product--info d-flex d-flex-dir-c">
      <a
        href="{{ product.url }}"
        class="cursor-pointer fnt-16 button-rest-styles text-color"
        toggle-element="options-drawer"
        type="submit"
      >
        {{ title }}
      </a>
      <!-- form content -->

      <div class="d-flex justify-content-space-btw mt-12 fnt-14 text-color">
        {% comment %} Price {% endcomment %}
        {% render 'price', product: product, on_sale: on_sale, hide_percentage_off: true, use_variant: true %}
        {% comment %} Product form {% endcomment %}
      </div>
    </div>
  </div>
{% endif %}
