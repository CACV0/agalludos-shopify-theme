{%- liquid
  assign has_no_varaint = false
  if product.has_only_default_variant or product.variants_count == 1
    assign has_no_varaint = true
  endif

  assign is_product_available = product.selected_or_first_available_variant.available
  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign image_aspect_class = ''
  if media_aspect_ratio
    assign image_aspect_class = 'aspect-ratio-' | append: media_aspect_ratio | default: 'square'
  endif
-%}
{% if product.available %}
  <div class="view-all-item" animate-drawer-item>
    <product-card
      product-handle="{{ product.handle }}"
      product-id="{{ product.selected_or_first_available_variant.id }}"
    >
      <div class="d-flex d-flex-dir-c view-all__flex__wrap">
        {%- assign product_image = product.selected_or_first_available_variant.featured_image
          | default: product.featured_media
        -%}

        {% capture image_class %}object-fit-{{ settings.image_fit }} image--aspectSize{% endcapture %}
        <a href="{{ product.url }}" class="view-all-item__image-wrp">
          <div
            class="image--aspectSize {{ image_aspect_class }}"
            {%- if media_aspect_ratio == 'adapt' and product.featured_media -%}
              style="--aspect-ratio: {{ product.featured_media.aspect_ratio }}"
            {%- endif -%}
          >
            {%- if product_image -%}
              {{
                product_image
                | image_url: width: product_image.width
                | image_tag:
                  widths: '300,200',
                  sizes: '(max-width: 767) 57px',
                  alt: product.featured_media.alt,
                  loading: 'lazy',
                  class: image_class
              }}
            {%- else -%}
              <div class="product-cart-no-image-container">
                <div class="product-cart-no-image">
                  <a class="view-all-item__Head fnt-14  color-text" href="{{ product.url }}">
                    {{- product.title | truncate: 45 -}}
                  </a>
                </div>
              </div>
            {%- endif -%}
          </div>
          {% comment %} Product form — show add-to-cart for products without variants, quick view for products with variants {% endcomment %}
            {% form 'product', product, class: 'product-card-item__form ', data-product-available: is_product_available %}
              <input
                name="id"
                type="hidden"
                value="{{ product.selected_or_first_available_variant.id }}"
              >
              <input
                name="quantity"
                type="hidden"
                value="1"
              >

              {%- if has_no_varaint -%}
                {% comment %} Direct add-to-cart for single-variant products {% endcomment %}
                <button
                  class="btn btn--fill text-upper btn--sm btn--icon"
                  toggle-element="cart-drawer"
                  aria-label="{{ 'products.product.button_add_to_cart' | t }}"
                  type="submit"
                >
                  <div class="btn--preloader justify-content-center d-v-center">
                    <div class="btn--preloader--circular">
                      <div class="checkmark draw"></div>
                    </div>
                  </div>
                  <div class="btn--text d-v-center justify-content-center">
                    {% render 'icon', icon: 'plus', color_var: 'var(--color-button-text)' %}
                  </div>
                </button>
              {%- else -%}
                {% comment %} Opens options drawer for products with multiple variants {% endcomment %}
                <button
                  class="btn btn--fill  text-upper btn--sm btn--icon"
                  toggle-element="options-drawer"
                  aria-label="{{ 'products.product.button_quick_view' | t }}"
                  type="submit"
                >
                  <div class="btn--preloader justify-content-center d-v-center">
                    <div class="btn--preloader--circular">
                      <div class="checkmark draw"></div>
                    </div>
                  </div>
                  <div class="btn--text d-v-center justify-content-center">
                    {% render 'icon' with 'eye-icon', width: '20', height: '12', color: 'var(--color-button-text)' %}
                  </div>
                </button>
              {%- endif -%}
            {% endform %}
        </a>

        <div class="view-all-item__content">
          {% comment %} Title {% endcomment %}
          {%- if product_image -%}
            <a class="view-all-item__Head fnt-14  color-text" href="{{ product.url }}">
              {{- product.title | truncate: 45 -}}
            </a>
          {%- endif -%}
          <div class="d-flex justify-content-space-btw align-item-center fnt-14">
            {% comment %} Price {% endcomment %}
            {% render 'price', product: product, on_sale: on_sale, hide_percentage_off: true %}
          </div>
        </div>
      </div>

      {% comment %} Form {% endcomment %}
    </product-card>
  </div>
{% endif %}
