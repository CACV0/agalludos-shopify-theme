{% liquid
  assign product_onboarding = true
  assign product_size = block.settings.product_list.count
  if product_size > 0
    assign product_onboarding = false
  endif
  assign poster_image = block.settings.feed_image | default: block.settings.video.preview_image
  assign show_play_button = true
%}

<shoppable-feed-card
  {{ block.shopify_attributes }}
  class="d-block shoppable__feed--card  aspect-ratio-{{ media_aspect_ratio }} position-relative"
  style="--color-text: {{ section.settings.feed_text_color }}"
>
  <div class="d-flex align-item-end h-100 shoppable__feed--card--product__list">
    <animation-reveal class="w-100" aoi-type="fade-up" aoi-duration="0.5" aoi-amount="0.3">
      <carousel-component
        class="swiper"
        slide-layout-type="carousel"
        slide-per-view="1"
        slide-grab-cursor="{{ settings.enable_grab_cursor }}"
        slide-responsive-breakpoints='{"450":{"slidesPerView": "1"}}'
        slide-disable-touch-move
        {% if product_size > 1 %}
          slide-speed="600"
          slide-autoplay="true"
          slide-autoplay-delay="4"
          slide-loop
          slide-enable-after-interaction
        {% endif %}
      >
        <div class="swiper-container" main-slider>
          <div class="swiper-wrapper">
            {%- for product in block.settings.product_list -%}
              <div class="swiper-slide h-auto">
                {% render 'feed-product-card', product: product %}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </carousel-component>
    </animation-reveal>
  </div>
  <div class="shoppable__feed--card--media position-absolute border-radius border-radius--block">
    {%- if block.settings.video -%}
      <feed-player
        video-playing="false"
        class="d-block h-100"
        {% if section.settings.play_media_on == 'play_on_hover' %}
          play-on-hover
        {% endif %}
        {% if index == 1 and section.settings.only_first_video %}
          feed-media-autoplay
        {% endif %}
      >
        <div
          class="shoppable__feed--card--overlay element-cover {%  unless show_play_button -%} cursor-pointer {%- endunless -%}"
          style="background: {{ media_overlay_background }}"
          pause-media
        ></div>
        {% comment %} Video play button {% endcomment %}
        {% if show_play_button -%}
          <div
            tabindex="0"
            aria-label="Video play button"
            class="shoppable__feed--card--play__button icon-center"
            style="--color-background: {{ section.settings.play_button_bg }}; --color-icon: {{ section.settings.play_button_color }} "
            play-media
            video-overlay-elements
          >
            {% render 'icon', icon: 'feed-play' %}
          </div>
        {%- endif -%}
        {% comment %} Video mute/unmute buttons {% endcomment %}
        <div
          class="shoppable__feed--card--audio__state position-absolute cursor-pointer"
          audio-state="{%- if section.settings.play_media_on == 'play_on_hover' -%} mute {%- elsif index == 1 and section.settings.only_first_video -%} mute {%- else -%} unmute {%- endif -%}"
          tabindex="0"
          aria-label="Mute/Unmute Audio"
        >
          <div class="audio__umute">
            {% render 'icon', icon: 'unmute-audio' %}
          </div>
          <div class="audio__mute">
            {% render 'icon', icon: 'mute-audio' %}
          </div>
        </div>
        <video
          class="position-absolute"
          preload="metadata"
          webkit-playsinline
          playsinline
          poster="false"
          loop
          disablepictureinpicture
          {% if block.settings.video.alt %}
            aria-label="{{ block.settings.video.alt }}"
          {% endif %}
        >
          {% for source in block.settings.video.sources %}
            <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
          {% endfor %}
          {{ 'section.video.error_text' | t }}
        </video>
        <div class="set-100-percentage-size-media media-preview-element position-absolute" video-overlay-elements image-container
          style="inset:0;">
          {{
            poster_image
            | image_url: width: poster_image.width
            | image_tag:
              widths: '1336,800,600',
              sizes: sizes,
              alt: poster_image.alt,
              loading: media_loading_type,
              fetchpriority: media_fetch_priority,
              class: 'w-100 h-100 object-fit-cover border-radius--block',
              is: 'image-loading'
          }}
          {% if poster_image %}
            {{
              poster_image
              | image_url: width: 40
              | image_tag:
                alt: poster_image.alt,
                class: 'blur-image',
                loading: media_loading_type,
                fetchpriority: media_fetch_priority
            }}
          {% endif %}
        </div>
        <div class="video__loader">
          <div class="preloader-circle"></div>
        </div>
      </feed-player>
    {%- else -%}
      <div class="d-block h-100" image-container>
        <div
          class="shoppable__feed--card--overlay element-cover {%  unless show_play_button -%} cursor-pointer {%- endunless -%}"
          style="background: {{ media_overlay_background }}"
          {% unless show_play_button and block.settings.feed_image == blank -%}
            media-interaction-element
          {%- endunless -%}
        >
          {% comment %} Render buttons based on image or video {% endcomment %}
          {% comment %}
            {%  if show_play_button -%}
                <div class="shoppable__feed--card--play__button icon-center" style="--color-background: {{ section.settings.play_button_bg }}; --color-icon: {{ section.settings.play_button_color }}"  {% unless block.settings.feed_image == blank -%} media-interaction-element {%- endunless -%} >
                        {%- render 'icon', icon: 'product-zoom', set_scheme_color: true -%}
                </div>
            {%- endif -%}
          {% endcomment %}
        </div>
        {%- if block.settings.feed_image -%}
          {{
            block.settings.feed_image
            | image_url: width: block.settings.feed_image.width
            | image_tag:
              widths: '500,600',
              sizes: '(min-width: 1400px) 314px, (min-width: 1220px) 247px, (min-width: 1000px) 365px, (min-width: 780px) 261px, (min-width: 580px) 313px, (min-width: 480px) calc(67.5vw - 51px), calc(67.5vw - 23px)',
              alt: block.settings.feed_image.alt,
              loading: 'lazy',
              fetchpriority: media_fetch_priority,
              class: 'feed__image',
              is: 'image-loading'
          }}
          {{
            block.settings.feed_image
            | image_url: width: 40
            | image_tag:
              alt: block.settings.feed_image.alt,
              class: 'blur-image',
              loading: 'lazy',
              fetchpriority: media_fetch_priority
          }}
        {%- else -%}
          {{ 'collection-apparel-2' | placeholder_svg_tag: 'feed__image' }}
        {% endif %}
      </div>
    {%- endif -%}
  </div>
</shoppable-feed-card>
