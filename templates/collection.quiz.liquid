<div id="product_list">
  {%- liquid
    layout none

    paginate collection.products by 50
      assign totalPages = paginate.pages
      for product in collection.products
        if product.available
          echo '<div class="swiper-slide" >'
          render 'card-product', product: product, index: forloop.index0, show_only_form_on_overlay: true, allow_variant_popup: true
          echo '</div>'
        endif
      endfor
    endpaginate
  -%}
</div>
<div id="pagination">{{ totalPages }}</div>
