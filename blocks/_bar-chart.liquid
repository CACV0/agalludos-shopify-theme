{{ 'snippet-bar-chart.css' | asset_url | stylesheet_tag }}

{%- capture section_bg -%}{{ section.settings.color_scheme.settings.background }}{%- endcapture -%}
{%- capture block_bg -%}{{ block.settings.backgroundColor }}{%- endcapture -%}
{%- assign no_padding = false -%}
{%- if block_bg == 'rgba(0,0,0,0)' or block_bg == 'transparent' or block_bg == blank -%}
  {%- assign no_padding = true -%}
{%- elsif section_bg == block_bg -%}
  {%- if section.settings.color_scheme.settings.background_gradient == blank -%}
    {%- assign no_padding = true -%}
  {%- endif -%}
{%- endif -%}

{% if block.settings.collapsible %}
  <accordion-tab
    class="bar-chart d-block"
    style="--background-color: {{ block.settings.backgroundColor }};margin-bottom: {{ block.settings.block_bottom_spacing | append: 'px' }}"
  >
    <details
      accordionTab
      aria-expanded="false"
      class="accordion__item d-block"
      {{ block.shopify_attributes }}
    >
      <summary aria-label="Toggle content">
        <div class="accordion__item__head">
{% else %}
  <div
    class="bar-chart"
    style="--background-color: {{ block.settings.backgroundColor }};margin-bottom: {{ block.settings.block_bottom_spacing | append: 'px' }} ;"
  >
{% endif %}
<div class="d-v-center">
  <{{ block.settings.heading_tag }} class="fnt-20 m-0">{{ block.settings.heading }}</{{ block.settings.heading_tag }}>
  {% unless block.settings.tooltip == blank %}
    <div class="tooltip {% if block.settings.tooltip.size > 150 %} tooltip__left {% endif %}">
      {% render 'icon' with 'tooltip' %}
      <span class="tooltiptext fnt-12">{{ block.settings.tooltip }}</span>
    </div>
  {% endunless %}
</div>
{% if block.settings.collapsible %}
  </div>
  </summary>
{% endif %}
{% if block.settings.collapsible %}
  <div accordionBody class="accordion__item__body">
    <div class="accordion__item__body-content">
{% endif %}
<div class="bar-chart__content" style="--bar-height: 8px ; --progress-bar-padding: {% if no_padding %} 8px 0  {% else %}18px 16px 0{% endif %};">
  {% content_for 'blocks' %}
</div>
{% if block.settings.collapsible %}
  </div>
  </div>
  </details>
  </accordion-tab>
{% else %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Bar chart",
  "tag": null,
  "blocks": [
    {
      "type": "_bar-chart-progress-bar"
    },
    {
      "type": "_bar-chart-progress-bar-custom"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },

    {
      "type": "text",
      "id": "tooltip",
      "label": "Tooltip text",
      "default": "Tooltip text"
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Collapsible",
      "default": false
    },
    {
      "type": "color",
      "id": "backgroundColor",
      "label": "Background color",
      "default": "#F4F4F4"
    },
    {
      "type": "range",
      "id": "block_bottom_spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Bar chart",
      "category": "Product",
      "blocks": [
        {
          "type": "_bar-chart-progress-bar",
          "settings": {
            "percentage": 100
          }
        },
        {
          "type": "_bar-chart-progress-bar",
          "settings": {
            "percentage": 75
          }
        },
        {
          "type": "_bar-chart-progress-bar",
          "settings": {
            "percentage": 50
          }
        },
        {
          "type": "_bar-chart-progress-bar",
          "settings": {
            "percentage": 25
          }
        }
      ]
    }
  ]
}
{% endschema %}
