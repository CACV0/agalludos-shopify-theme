<style>
  .btn-{{ block.id }} {
      padding-bottom: {{ block.settings.bottom_mobile | append: 'px' }};
  }

  @media (min-width: 750px) {
    .btn-{{ block.id }} {
      padding-bottom: {{ block.settings.bottom_desktop | append: 'px' }};
    }
  }
</style>

{% if block.settings.button_label != blank %}
  {% assign delay = 0.05 %}
  <animation-reveal
    class="button-block__animation"
    aoi-type="fade-up"
    aoi-fade-delay="{{ delay }}"
    aoi-duration="0.6"
  >
    <div class="btn--wrap btn-{{ block.id }} ">
      <a
        class="btn {% if block.settings.use_outline_button %} btn--border {% else %} btn--fill {% endif %} slideshow__shop-btn"
        href="{{ block.settings.button_link }}"
        target="{{ block.settings.link_target }}"
      >
        {{- block.settings.button_label }}
      </a>
    </div>
  </animation-reveal>
{% endif %}
{% schema %}
{
  "name": "Button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "label": "Button label",
      "id": "button_label",
      "default": "Button Label",
      "info": "Leave the label blank to hide the button."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave the button text empty to make the slide fully clickable."
    },
    {
      "type": "select",
      "id": "link_target",
      "label": "Open link in",
      "options": [
        {
          "label": "New tab",
          "value": "_blank"
        },
        {
          "label": "Same tab",
          "value": "_top"
        }
      ],
      "default": "_top"
    },
    {
      "type": "checkbox",
      "id": "use_outline_button",
      "label": "Use outline button style",
      "default": false
    },
    {
      "type": "range",
      "id": "bottom_desktop",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "bottom_mobile",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(mobile)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Button"
    }
  ]
}
{% endschema %}
