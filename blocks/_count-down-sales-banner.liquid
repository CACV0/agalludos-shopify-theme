{%- capture section_bg -%}{{ section.settings.color_scheme.settings.background }}{%- endcapture -%}
{%- capture block_bg -%}{{ block.settings.background_color }}{%- endcapture -%}
{%- assign same_bg = false -%}
{%- assign no_padding = false -%}
{%- if block_bg == 'rgba(0,0,0,0)' or block_bg == 'transparent' or block_bg == blank -%}
  {%- assign no_padding = true -%}
  {%- if section.settings.color_scheme.settings.background_gradient == blank -%}
    {%- assign same_bg = true -%}
  {%- endif -%}
{%- elsif section_bg == block_bg -%}
  {%- if section.settings.color_scheme.settings.background_gradient == blank -%}
    {%- assign no_padding = true -%}
    {%- assign same_bg = true -%}
  {%- endif -%}
{%- endif -%}

<style>

  .countdown__container .group  {
     {% if same_bg %}
      border-radius: 0;
     {% endif %}
  }

  .countdown {
      padding-bottom: {{ block.settings.bottom_mobile | append: 'px' }};
  }

  @media (min-width: 750px) {
    .countdown {
      padding-bottom: {{ block.settings.bottom_desktop | append: 'px' }};
    }
  }
</style>

<div
  class="countdown"
  hide-on-expiry
>
  <div class="countdown__container" style=" --countdown-background-color:{{ block.settings.background_color }}; --countdown-padding: {% if no_padding %}0px{% else %}16px{% endif %};">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Count down sales banner",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8F6EA"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "bottom_desktop",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "bottom_mobile",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(mobile)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Count down sales banner",
      "category": "Product",
      "blocks": [
        {
          "type": "group",
          "blocks": [
            {
              "type": "content"
            },
            {
              "type": "timer"
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}
