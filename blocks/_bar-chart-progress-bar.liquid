{% liquid
  case block.settings.icon_style
    when 'tick'
      assign icon = 'icon-circle-tick'
    when 'arrow'
      assign icon = 'icon-circle-right-arrow'
    when 'star'
      assign icon = 'icon-circle-star'
    when 'diamond'
      assign icon = 'icon-circle-diamond'
  endcase
%}


<div class="bar-chart__progress-bar-container" 
  
    {{ block.shopify_attributes }}>
  {% render 'progress-bar' with value, value: block.settings.percentage, maxvalue: 100, progress_bar_color: block.settings.bar_color %}
  <div
    class="bar-chart__progress-bar-info"
    style="--icon-line-color: {{ block.settings.icon_color }}; --icon-bg-color: {{ block.settings.bar_color }};--color-text: {{ block.settings.text_color }}"
  >
    <div class="bar-chart__progress-bar-name-icon">
      <p class="bar-chart__icon" style="--icon-width: {{ block.settings.icon_width |  append: 'px'}}">
        {%- render 'icon' with icon, index: index -%}
      </p>
      {% unless block.settings.text == blank %}
        <p class="fnt-14 text-color m-0">{{ block.settings.text }}</p>
      {% endunless %}
    </div>
    <span class="fnt-14 fnt-body-weight-bold text-color">{{ block.settings.percentage | append: '%' }}</span>
  </div>
</div>

{% schema %}
{
  "name": "Bar",
  "class": "bar-chart__block",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Name",
      "default": "Name"
    },
    {
      "type": "range",
      "id": "percentage",
      "label": "Percentage",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Style",
      "options": [
        {
          "label": "Tick",
          "value": "tick"
        },
        {
          "label": "Arrow",
          "value": "arrow"
        },
        {
          "label": "Star",
          "value": "star"
        },
        {
          "label": "Diamond",
          "value": "diamond"
        }
      ],
      "default": "tick"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon width",
      "min": 16,
      "max": 40,
      "unit": "px",
      "step": 1,
      "default": 32
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Highlighted color",
      "default": "#676767"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Bar"
    }
  ]
}
{% endschema %}
