{% liquid
  case block.settings.icon_style
    when 'tick'
      assign icon = 'icon-circle-tick'
    when 'arrow'
      assign icon = 'icon-circle-right-arrow'
    when 'star'
      assign icon = 'icon-circle-star'
    when 'diamond'
      assign icon = 'icon-circle-diamond'
  endcase

  assign lines = block.settings.richtext | strip_html | split: '%'
%}

{% for line in lines %}
  {% if line != blank %}
    {% assign parts = line | split: ':' %}
    {% assign label = parts[0] | strip %}
    {% assign percent = parts[1] | strip | remove: '%' %}
    {% assign percent_number = percent | plus: 0 %}
    <div class="bar-chart__progress-bar-container" style="--bar-height: 8px" {{ block.shopify_attributes }}>
      {% render 'progress-bar' with value, value: percent_number, maxvalue: 100, progress_bar_color: block.settings.bar_color %}
      {% comment %}
        <div class="progressBar" style="--bg-color: {{ block.settings.bar_color.rgba }}">
                  <div class="progressBar__handle" style="--bar-width: {{  |  append: '%' }}"></div>
        </div>
      {% endcomment %}
      <div
        class="bar-chart__progress-bar-info"
        style="--icon-line-color: {{ block.settings.icon_color }}; --icon-bg-color: {{ block.settings.bar_color }};--color-text: {{ block.settings.text_color }}"
      >
        <div class="bar-chart__progress-bar-name-icon">
          <p class="bar-chart__icon" style="--icon-width: {{ block.settings.icon_width |  append: 'px'}}">
            {%- render 'icon' with icon, index: index -%}
          </p>

          <p class="fnt-14 text-color m-0">{{ label }}</p>
        </div>
        <span class="fnt-14 fnt-body-weight-bold text-color">{{ percent_number | append: '%' }}</span>
      </div>
    </div>
  {% endif %}
{% endfor %}

{% schema %}
{
  "name": "Custom bar",
  "class": "bar-chart__block",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "richtext",
      "label": "Nutritions details",
      "info": "Define a metafield using the key custom.metafield_key to personalize content. Update metafield_key to match your specific use case. [Learn more](https://help.ascendthemes.com/article/61-product-page)"
    },
    {
      "type": "header",
      "content": "Icon"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Style",
      "options": [
        {
          "label": "Tick",
          "value": "tick"
        },
        {
          "label": "Arrow",
          "value": "arrow"
        },
        {
          "label": "Star",
          "value": "star"
        },
        {
          "label": "Diamond",
          "value": "diamond"
        }
      ],
      "default": "tick"
    },
    {
      "type": "range",
      "id": "icon_width",
      "label": "Icon width",
      "min": 16,
      "max": 40,
      "unit": "px",
      "step": 1,
      "default": 32
    },
    {
      "type": "color",
      "id": "bar_color",
      "label": "Highlighted color",
      "alpha": true,
      "default": "#676767"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Bar dynamic source"
    }
  ]
}
{% endschema %}
{% comment %}

This file has been rewritten to preserve the original behavior.

---
Changes:
- from: |-
    {%
            render 'progress-bar' with value: percent_number
            , maxvalue: 100
            , progress_bar_color: block.settings.bar_color
          %}
  to: "{% render 'progress-bar' with value, value: percent_number, maxvalue: 100,
    progress_bar_color: block.settings.bar_color %}"
  position: 718..840
{% endcomment %}