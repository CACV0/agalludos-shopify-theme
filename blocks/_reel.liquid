{% assign product = closest.product %}
<div class="swiper-slide ugc-reel__card" snap-slider-item>
  <div class="ugc-reel__card--container" {{ block.shopify_attributes }}>
    {% if block.settings.reel_video != blank %}
      <div
        class="ugc-reel__card__video"
        role="button"
        tabindex="0"
      >
        <reel-feed-player
          class="d-block custom__player__element position-relative set-100-percentage-size-media"
          watch-element
          data-media-type="video"
          role="group"
          aria-label="{{ 'products.product.ugc.video_player' | t }}"
        >
        <video
        preload="metadata"
        poster="false"
        webkit-playsinline
        playsinline
        {% if block.settings.reel_video.alt %}
          aria-label="{{ block.settings.reel_video.alt}}"
        {% endif %}
        >
        {%- for source in block.settings.reel_video.sources -%}
          <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
        {{ 'section.video.error_text' | t }}
        </video>
        <div
        class="set-100-percentage-size-media ugc-reel__card__video--preview-element position-absolute {% if block.settings.reel_image == blank %}no-cover-image{% endif %}"
        video-preview-elements
        image-container
        >
        {% liquid
        assign cover_image = block.settings.reel_image | default: block.settings.reel_video.preview_image
        %}
        {% if cover_image != blank %}
          {{
            cover_image
            | image_url: width: cover_image.width
            | image_tag:
            widths: '500,600',
            sizes: '(min-width: 1400px) 314px, (min-width: 1220px) 247px, (min-width: 1000px) 365px, (min-width: 780px) 261px, (min-width: 580px) 313px, (min-width: 480px) calc(67.5vw - 51px), calc(67.5vw - 23px)',
            alt: cover_image.alt,
            loading: 'lazy',
            class: 'set-100-percentage-size-media primary_image',
            is: 'image-loading'
            }}
          {{
            cover_image
            | image_url: width: 20
            | image_tag:
              class: 'blur-image',
              alt: cover_image.alt,
              loading: 'lazy'
          }}
          {% endif %}
          </div>
          <div class="preloader-circle"></div>
          <div
            class="ugc-reel__card__video--card--overlay element-cover "
            pause-media
          ></div>
          <div
            class="ugc-reel__card__video--play-button video__overlay__elements"
            video-overlay-elements
          >
            <div
              tabindex="0"
              aria-label="{{ 'products.product.ugc.play_button' | t }}"
              class="ugc-reel__card__video--play-icon icon-center"
              play-media
            >
              {% render 'icon' with 'play' %}
            </div>
          </div>
          <div
            class="ugc-reel__card__video--controls position-absolute cursor-pointer"
            audio-state="unmute"
            tabindex="0"
            aria-label="{{ 'products.product.ugc.mute_unmute_audio' | t }}"
          >
            <div class="audio__umute">
              {% render 'icon', icon: 'unmute-audio' %}
            </div>
            <div class="audio__mute">
              {% render 'icon', icon: 'mute-audio' %}
            </div>
          </div>
          <div class="ugc-reel__card__video--progress position-absolute" video-progress-bar>
            <div class="ugc-reel__card__video--progress--bar" video-progress-bar-fill></div>
          </div>
        </reel-feed-player>
      </div>
    {% else %}
      <div
        class="ugc-reel__card__img"
        data-media-type="image"
        image-playing="true"
        role="button"
        tabindex="0"
      >
        <div class="ugc-reel__card__img--wrapper" image-container>
          {% if block.settings.reel_image %}
            {{
              block.settings.reel_image
              | image_url: width: block.settings.reel_image.width
              | image_tag:
              widths: '500,600',
              sizes: '700px',
              alt: block.settings.reel_image.alt,
              loading: 'lazy',
              class: 'set-100-percentage-size-media',
              is: 'image-loading'
              }}
            {{
              block.settings.reel_image
              | image_url: width: 20
              | image_tag:
                class: 'blur-image',
                alt: block.settings.reel_image.alt,
                loading: 'lazy'
            }}
          {% else %}
            {{
              'hero-apparel-1'
              | placeholder_svg_tag: 'placeholder-svg set-100-percentage-size-media'
            }}
          {% endif %}
        </div>
        <div
          class="ugc-reel__card__img--card--overlay element-cover"
          pause-image-media
        ></div>
        <div
          class="ugc-reel__card__img--play-button video__overlay__elements"
          image-play-overlay
        >
          <div
            tabindex="0"
            aria-label="{{ 'products.product.ugc.play_button' | t }}"
            class="ugc-reel__card__video--play-icon icon-center"
            play-image-media
          >
            {% render 'icon' with 'play' %}
          </div>
        </div>
        <div class="ugc-reel__card__img--progress position-absolute" image-progress-bar>
          <div class="ugc-reel__card__img--progress--bar" image-progress-bar-fill></div>
        </div>
      </div>
    {% endif %}
    <div class="ugc-reel__card__product position-absolute" reel-feed-card>
      {% if product != blank %}
        {% render 'reel-feed-product-card', product: product, section: section %}
      {% endif %}
    </div>
    <div class="ugc-reel__card__overlay"></div>
  </div>
</div>

{% schema %}
{
  "name": "Reel",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "reel_video",
      "label": "Video"
    },
    {
      "type": "image_picker",
      "id": "reel_image",
      "label": "Image",
      "info": "This image will be used as cover if video is added"
    }
  ],
  "presets": [
    {
      "name": "Reel"
    }
  ]
}
{% endschema %}
