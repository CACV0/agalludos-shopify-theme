<div
  class="
    group group-{{ block.settings.direction }} {% if block.blocks.size == 1  %} is-single-block {% endif %}
    justify-content-{{ block.settings.alignment }}
      {% if block.settings.direction == 'row' %} align-item-center {% endif %}
      {% if block.settings.vertical_mobile %} group-mobile-column  {% endif %}
  "
  style="
    --group-gap: {{ block.settings.gap_mobile |  append: 'px' }} ;
    --group-gap-desktop : {{ block.settings.gap_desktop |  append: 'px' }};
    --bottom-spacing-desktop:{{ block.settings.bottom_spacing_desktop }}px;
    --bottom-spacing-mobile:{{ block.settings.bottom_spacing_mobile }}px;
  "
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Group",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "column",
          "label": "Vertical"
        },
        {
          "value": "row",
          "label": "Horizontal"
        }
      ],
      "default": "row"
    },
    {
      "type": "checkbox",
      "id": "vertical_mobile",
      "label": "Vertical on mobile",
      "default": true,
      "visible_if": "{{ block.settings.direction == 'row' }}"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "visible_if": "{{  block.settings.direction == 'row' }}",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "end",
          "label": "Right"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-evenly",
          "label": "Space Evenly"
        },
        {
          "value": "space-btw",
          "label": "Space between"
        },
        {
          "value": "space-around",
          "label": "Space around"
        }
      ],
      "default": "space-btw"
    },

    {
      "type": "range",
      "id": "gap_desktop",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap(Desktop)",
      "default": 5,
      "visible_if": "{{ block.settings.direction == 'row' or block.settings.direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Gap(Mobile)",
      "default": 5,
      "visible_if": "{{ block.settings.vertical_mobile  or block.settings.direction == 'column' }}"
    },
    {
      "type": "range",
      "id": "bottom_spacing_desktop",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(desktop)",
      "default": 5
    },
    {
      "type": "range",
      "id": "bottom_spacing_mobile",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(mobile)",
      "default": 5
    }
  ],
  "presets": [
    {
      "name": "Group",
      "category": "Layout"
    }
  ]
}
{% endschema %}
