{% comment %} Editorial Content — Countdown Timer {% endcomment %}
<script defer src="{{ 'countdown-timer.js' | asset_url }}"></script>

{% assign hide_timer = false %}
{% if block.settings.hide_timer_on_ending == 'hide_on_completion' %}
  {% assign hide_timer = true %}
{% endif %}

<animation-reveal aoi-type="stagger" aoi-delay="0.13" aoi-duration="0.6">
  <div
    class="pdp-countdown-timer d-flex justify-content-{{ section.settings.desktop_content_alignment }} justify-content-{{ section.settings.mobile_content_alignment }}-md"
    {{ block.shopify_attributes }}
    {% if hide_timer %}
      hide-on-expiry-parent-element
    {% endif %}
  >
    {% render 'countdown-timer', block: block %}
  </div>
</animation-reveal>

