{% render 'accordion', block: block %}

{% schema %}
{
  "name": "Collapsible text",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "text",
      "label": "Heading",
      "id": "heading",
      "default": "Title"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "richtext",
      "label": "Content",
      "id": "content",
      "default": "<p>Write a clear and concise answer to guide your customers.</p>"
    },
    {
      "type": "page",
      "label": "Select page",
      "id": "page"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_image_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Desktop image width",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_image_width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Mobile image width",
      "default": 100
    },
    {
      "type": "range",
      "id": "block_bottom_spacing",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Collapsible text",
      "category": "Product"
    }
  ]
}
{% endschema %}
