<style>
  .sub-heading--{{ block.id }} {
      padding-bottom: {{ block.settings.bottom_mobile | append: 'px' }};
  }

  @media (min-width: 750px) {
    .sub-heading--{{ block.id }} {
      padding-bottom: {{ block.settings.bottom_desktop | append: 'px' }};
    }
  }
</style>

{% if block.settings.subheading != blank %}
  {% assign delay = 0 %}
  <animation-reveal
    class=""
    aoi-type="fade-up"
    aoi-fade-delay="{{ delay }}"
    aoi-duration="0.6"
  >
    <p class="text-color sub-heading--{{ block.id }} mb-2">{{ block.settings.subheading }}</p>
  </animation-reveal>
{% endif %}
{% schema %}
{
  "name": "Sub heading",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subheading"
    },
    {
      "type": "range",
      "id": "bottom_desktop",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(desktop)",
      "default": 16
    },
    {
      "type": "range",
      "id": "bottom_mobile",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing(mobile)",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Sub heading"
    }
  ]
}
{% endschema %}
