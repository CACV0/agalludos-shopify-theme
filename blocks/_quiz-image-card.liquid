{% render 'quiz-slide', block: block %}

{% schema %}
{
  "name": "Card options",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "label": "Multiple choice",
      "id": "multiple_choice",
      "default": false,
      "info": "Allow multiple selections. With AND logic. applied, only products containing every chosen tag will be shown."
    },
    {
      "type": "checkbox",
      "label": "Skip",
      "id": "skip_question",
      "default": false,
      "info": "If a question isn’t mandatory, users can skip it"
    },
    {
      "type": "header",
      "content": "Option Layout"
    },
    {
      "type": "select",
      "id": "quiz_columns",
      "label": "Number of options on desktop",
      "options": [
        {
          "label": "3",
          "value": "3"
        },
        {
          "label": "4",
          "value": "4"
        }
      ],
      "default": "3",
      "visible_if": "{{ section.settings.layout_style == 'column' }}"
    },
    {
      "type": "select",
      "label": "Option",
      "id": "image_type",
      "default": "image",
      "options": [
        {
          "label": "Image",
          "value": "image"
        },
        {
          "label": "Text",
          "value": "text"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "default": "adapt",
      "visible_if": "{{ block.settings.image_type == 'image' }}",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ]
    },

    {
      "type": "text",
      "id": "question",
      "label": "Question",
      "default": "Ask your question here?"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "select",
      "id": "style",
      "label": " Header size",
      "options": [
        {
          "label": "H1",
          "value": "h1"
        },
        {
          "label": "H2",
          "value": "h2"
        },
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ],
      "default": "h1"
    },
     {
      "type": "select",
      "id": "option_style",
      "label": "Size",
      "options": [
        {
          "label": "H1",
          "value": "h1"
        },
        {
          "label": "H2",
          "value": "h2"
        },
        {
          "label": "H3",
          "value": "h3"
        },
        {
          "label": "H4",
          "value": "h4"
        },
        {
          "label": "H5",
          "value": "h5"
        },
        {
          "label": "H6",
          "value": "h6"
        }
      ],
      "default": "h4"
    },
    {
      "type": "header",
      "content": "Options 1"
    },
    {
      "type": "checkbox",
      "id": "option_1_enabled",
      "label": "Enable option 1",
      "default": true
    },
    {
      "type": "text",
      "id": "option_1",
      "label": "Option 1",
      "default": "Option 1",
      "visible_if": "{{ block.settings.option_1_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_1",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_1_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_1",
      "label": "Description",
      "visible_if": "{{ block.settings.option_1_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_1_enabled }}"
    },
    {
      "type": "header",
      "content": "Options 2"
    },
    {
      "type": "checkbox",
      "id": "option_2_enabled",
      "label": "Enable option 2",
      "default": true
    },
    {
      "type": "text",
      "id": "option_2",
      "label": "Option 2",
      "default": "Option 2",
      "visible_if": "{{ block.settings.option_2_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_2",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_2_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_2",
      "label": "Description",
      "visible_if": "{{ block.settings.option_2_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_2_enabled }}"
    },
    {
      "type": "header",
      "content": "Options 3"
    },
    {
      "type": "checkbox",
      "id": "option_3_enabled",
      "label": "Enable option 3",
      "default": false
    },
    {
      "type": "text",
      "id": "option_3",
      "label": "Option 3",
      "default": "Option 3",
      "visible_if": "{{ block.settings.option_3_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_3",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_3_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_3",
      "label": "Description",
      "visible_if": "{{ block.settings.option_3_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_3_enabled }}"
    },
    {
      "type": "header",
      "content": "Options 4"
    },
    {
      "type": "checkbox",
      "id": "option_4_enabled",
      "label": "Enable option 4",
      "default": false
    },
    {
      "type": "text",
      "id": "option_4",
      "label": "Option 4",
      "default": "Option 4",
      "visible_if": "{{ block.settings.option_4_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_4",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_4_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_4",
      "label": "Description",
      "visible_if": "{{ block.settings.option_4_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_4_enabled }}"
    },
    {
      "type": "header",
      "content": "Options 5"
    },
    {
      "type": "checkbox",
      "id": "option_5_enabled",
      "label": "Enable option 5",
      "default": false
    },
    {
      "type": "text",
      "id": "option_5",
      "label": "Option 5",
      "default": "Option 5",
      "visible_if": "{{ block.settings.option_5_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_5",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_5_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_5",
      "label": "Description",
      "visible_if": "{{ block.settings.option_5_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_5_enabled }}"
    },
    {
      "type": "header",
      "content": "Options 6"
    },
    {
      "type": "checkbox",
      "id": "option_6_enabled",
      "label": "Enable option 6",
      "default": false
    },
    {
      "type": "text",
      "id": "option_6",
      "label": "Option 6",
      "default": "Option 6",
      "visible_if": "{{ block.settings.option_6_enabled }}"
    },
    {
      "type": "text",
      "id": "tag_6",
      "label": "Tags",
      "info": "Use commas to combine multiple tags (case sensitive)",
      "default": "Add a tag",
      "visible_if": "{{ block.settings.option_6_enabled }}"
    },
    {
      "type": "richtext",
      "id": "caption_6",
      "label": "Description",
      "visible_if": "{{ block.settings.option_6_enabled and block.settings.content_layout == 'below' or block.settings.image_type == 'text' }}"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.option_6_enabled }}"
    },
    {
      "type": "header",
      "content": "Option appearance"
    },
    {
      "type": "select",
      "id": "content_layout",
      "label": "Content layout",
      "default": "below",
      "visible_if": "{{ block.settings.image_type == 'image' }}",
      "options": [
        {
          "label": "Below image",
          "value": "below"
        },
        {
          "label": "Overlay",
          "value": "overlay"
        }
      ]
    },
    {
      "type": "text_alignment",
      "id": "content_alignment",
      "label": "Content alignment"
    },
    {
      "type": "select",
      "id": "vertical_content_alignment",
      "label": "Content position",
      "visible_if": "{{ block.settings.image_type == 'text' or block.settings.image_type == 'image' and block.settings.content_layout == 'overlay' }}",
      "options": [
        {
          "label": "Top",
          "value": "start"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "end"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "option_heading_tag",
      "label": "Option text size",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "visible_if": "{{ block.settings.image_type == 'text' or block.settings.image_type == 'image' and block.settings.content_layout == 'below' }}",
      "default": "#ffffff"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Overlay color",
      "visible_if": "{{ block.settings.image_type == 'image' and block.settings.content_layout == 'overlay' }}",
      "default": "linear-gradient(180deg, rgba(0, 0, 0, 0.00) 0%, rgba(0, 0, 0, 0.70) 100%)"
    },
    {
      "type": "color",
      "id": "option_hover_active_color",
      "label": "Option hover/active color",
      "default": "#DF3B3A"
    },
    {
      "type": "color",
      "id": "option_hover_active_text_color",
      "label": "Option hover/active text color",
      "default": "#ffffff"
    },

    {
      "type": "header",
      "content": "Pop up"
    },
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "Enable pop up",
      "default": false
    },
    {
      "type": "text",
      "id": "popup_link_text",
      "label": "Link text",
      "default": "Access support and guidance here",
      "visible_if": "{{ block.settings.enable_popup }}"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Pop up heading",
      "default": "Heading",
      "visible_if": "{{ block.settings.enable_popup }}"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Pop up content",
      "visible_if": "{{ block.settings.enable_popup }}"
    },
    {
      "type": "text_alignment",
      "id": "guide_content_alignment",
      "label": "Content alignment",
      "default": "left",
      "visible_if": "{{ block.settings.enable_popup }}"
    }
  ],
  "presets": [
    {
      "name": "Card options",
      "category": "Products"
    }
  ]
}
{% endschema %}
