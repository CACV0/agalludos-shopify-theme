<div
  class="swiper-slide color-{{ block.settings.color_scheme }} mobile-color-{{ block.settings.color_scheme_mobile }}"
  data-color-scheme="color-{{ block.settings.color_scheme }} mobile-color-{{ block.settings.color_scheme_mobile }}"
  {{ block.shopify_attributes }}
  role="region"
>
  {% liquid
    if section.settings.media_size == 'adapt'
      assign ratio = block.settings.slide_image.aspect_ratio
    endif
    if section.settings.mobile_media_size == 'adapt'
      assign mobile_ratio = block.settings.slide_image.aspect_ratio
      if block.settings.mobile_slide_image != blank
        assign mobile_ratio = block.settings.mobile_slide_image.aspect_ratio
      endif
    endif
  %}
  <div
    class="slideshow__slide slideshow__slide--bgColor {% if block.settings.image_video_width == 'full' %} media-size--{{ section.settings.media_size }}  media-size-mobile--{{ section.settings.mobile_media_size }} {% endif %} {% if  block.settings.image_video_positin == 'right' %} image-right {% endif %}"
    style="{% if section.settings.media_size == 'adapt' %} --aspect-ratio: {{ ratio }}; {% endif %}{% if  section.settings.mobile_media_size == 'adapt'  %}  --mobile-aspect-ratio: {{ mobile_ratio }}{% endif %}"
  >
    <div
      class="slideshow__slideImg  {% if block.settings.image_video_width != 'full' %} media-size--{{ section.settings.media_size }} media-size-mobile--{{ section.settings.mobile_media_size }} {% endif %} {% if block.settings.image_video_width == 'full' %} image-full-width {% else %} position-relative {% endif %} {% if block.settings.mobile_slide_image != blank %} mobile-image-available {% endif %}"
      image-container
    >
      {% comment %} Half-width: link lives inside the image div so it can only cover the image area, never the content side {% endcomment %}
      {% if block.settings.enable_image_link and block.settings.slide_link != blank %}
        <a
          class="slideshow__slide-link"
          href="{{ block.settings.slide_link }}"
          target="{{ block.settings.slide_link_target }}"
          aria-label="{{ block.settings.slide_link | default: 'Slide link' }}"
        >
      {% endif %}
      <animation-reveal aoi-type="scale" aoi-delay="0.2" aoi-duration="0.6" aoi-amount="0">
        {% if block.settings.overlay_color != 'rgba(0,0,0,0)' %}
          {%- assign overlay_rgba_color = block.settings.overlay_color.rgba -%}
          <div
            class="image__overlay position-absolute {% if block.settings.hide_on_desktop %} hide-over-on-desktop {% endif %}"
            style="background-color:  rgba({{ overlay_rgba_color }})"
            video-overlay-elements
          ></div>
        {% endif %}
        {%- capture sizes -%}
                        {%- if block.settings.image_video_width == 'full' -%}
                          100vw
                          {%- else -%}
                          (min-width: 780px) calc(50vw - 100px), (min-width: {{ settings.page_width | append: 'px' }}) calc({{ settings.page_width |  divided_by: 2 |  append: 'px' }} - 100px), calc(100vw - 15px)
                        {%- endif -%}
                      {%- endcapture -%}
        {% if block.settings.slide_image != blank %}
          {{
            block.settings.slide_image
            | image_url: width: block.settings.slide_image.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              alt: block.settings.slide_image.alt,
              widths: '2040,1600,1335,900,700',
              sizes: sizes,
              class: 'desktop-image',
              is: 'image-loading'
          }}
        {% else %}
          {{ 'hero-apparel-1' | placeholder_svg_tag: 'slideshow__svg desktop-image' }}
        {% endif %}
        {% if block.settings.mobile_slide_image != blank %}
          {{
            block.settings.mobile_slide_image
            | image_url: width: block.settings.mobile_slide_image.width
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              alt: block.settings.mobile_slide_image.alt,
              widths: '767,512,320',
              sizes: 'calc(100vw-30px)',
              class: 'mobile-image',
              is: 'image-loading'
          }}
        {% endif %}
      </animation-reveal>
      {% if block.settings.slide_image != blank %}
        {{
          block.settings.slide_image
          | image_url: width: 40
          | image_tag:
            class: 'blur-image desktop-image',
            loading: loading,
            fetchpriority: fetchpriority,
            alt: block.settings.slide_image.alt
        }}
      {% endif %}
      {% if block.settings.mobile_slide_image != blank %}
        {{
          block.settings.mobile_slide_image
          | image_url: width: 40
          | image_tag:
            class: 'blur-image mobile-image',
            loading: loading,
            fetchpriority: fetchpriority,
            alt: block.settings.mobile_slide_image.alt
        }}
      {% endif %}

      {% if block.settings.enable_image_link and block.settings.slide_link != blank %}
        </a>
      {% endif %}
    </div>
    <div
      class=" {% if section.settings.section_width %} container {% else %} d-flex flex-1 {% endif %} {% if block.settings.image_video_width == 'full' %} full-image-content {% endif %}{% unless block.settings.image_video_width == 'full' %} slideshow__slideContent {% endunless %} content-desktop-alignment-{{ block.settings.desktop_content_position }} content-mobile-alignment-{{ block.settings.mobile_content_position }}"
      role="region"
      aria-label="Slide Content"
    >
      <div
        class="slideshow__slideBody {% unless section.settings.section_width or block.settings.image_video_width == 'half' %} fix-width-container {% endunless %} {% unless section.settings.desktop_navigation == 'arrows' %} arrows-not-at-verticle-center {% endunless %} text-{{ block.settings.desktop_content_alignment }} text-{{ block.settings.mobile_content_alignment }}-md margin-{{ block.settings.desktop_content_alignment }} margin-{{ block.settings.mobile_content_alignment }}-md"
        role="region"
        aria-label="Slide Text"
        style="--slider-content-width: {{ block.settings.content_width | append: "px" }}"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Image slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "select",
      "id": "image_video_width",
      "label": "Image width",
      "options": [
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "Half",
          "value": "half"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "image_video_positin",
      "label": "Image position",
      "info": "Only applicable when ‘image width’ is set to ‘half’",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "slide_image",
      "label": "Image",
      "info": "2880 x 1280px (large) .jpg recommended"
    },
    {
      "type": "image_picker",
      "id": "mobile_slide_image",
      "label": "Mobile image",
      "info": "740 x 1100px (large) .jpg recommended"
    },
    {
      "type": "checkbox",
      "id": "enable_image_link",
      "label": "Enable full slideshow click area",
      "info": "Makes the entire slide image clickable",
      "default": false
    },
    {
      "type": "url",
      "id": "slide_link",
      "label": "Link URL",
      "visible_if": "{{ block.settings.enable_image_link }}"
    },
    {
      "type": "select",
      "id": "slide_link_target",
      "label": "Open link in",
      "options": [
        {
          "label": "Same tab",
          "value": "_top"
        },
        {
          "label": "New tab",
          "value": "_blank"
        }
      ],
      "default": "_top",
      "visible_if": "{{ block.settings.enable_image_link }}"
    },
    {
      "type": "header",
      "content": "Content"
    },

    {
      "type": "range",
      "label": "Content width",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "unit": "px",
      "step": 20,
      "default": 480,
      "info": "Works only when 'Image width' is set to Full"
    },

    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "text_alignment",
      "id": "desktop_content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Content position",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text_alignment",
      "id": "mobile_content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Content position",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "top"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide overlay on desktop",
      "info": "Enabling this will show overlay only on mobile layout.Recommended when image width is set to half.",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "alpha": true,
      "default": "#0000005B"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-5",
      "label": "Desktop color scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_mobile",
      "default": "scheme-5",
      "label": "Mobile color scheme"
    }
  ],
  "presets": [
    {
      "name": "Image slide",
      "blocks": [
        {
          "type": "sub-heading"
        },
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
