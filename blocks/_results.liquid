<link
  href="{{ 'section-drawer-view-all-products.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
  rel="stylesheet"
>
<script src="{{ 'add-all-products-to-cart.js' | asset_url }}" defer></script>
{% if block.settings.results_layout == 'drawer' %}
  {% render 'quiz-results-drawer' %}
{% else %}
  {% render 'quiz-results-page', block: block %}
{% endif %}
{% schema %}
{
  "name": "Results",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "results_layout",
      "label": "Results layout",
      "options": [
        {
          "value": "page",
          "label": "Page"
        },
        {
          "value": "drawer",
          "label": "Drawer"
        }
      ],
      "default": "page"
    },
    {
      "type": "select",
      "id": "desktop_product_layout",
      "label": "Products layout",
      "visible_if": "{{ block.settings.results_layout == 'page' }}",
      "options": [
        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "grid",
          "label": "Grid"
        }
      ],
      "default": "carousel"
