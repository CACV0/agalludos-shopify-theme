{% liquid
  case block.settings.icon_style
    when 'truck'
      assign icon = 'icon-vehicle'
    when 'globe'
      assign icon = 'icon-globe'
    when 'box'
      assign icon = 'icon-box'
    when 'heart'
      assign icon = 'icon-heart'
    when 'gift'
      assign icon = 'icon-gift'
    when 'smile'
      assign icon = 'icon-smile'
    when 'back'
      assign icon = 'icon-back'
    when 'star'
      assign icon = 'icon-star-sm'
    when 'building'
      assign icon = 'building-icon'
    when 'timer'
      assign icon = 'timer-strok'
    when 'plane'
      assign icon = 'plane-icon'
    when 'credit-card'
      assign icon = 'credit-card'
    when 'lock'
      assign icon = 'lock-icon'
    when 'shield-strok'
      assign icon = 'shield-strok'
    when 'money'
      assign icon = 'money'
  endcase
%}

<div
  class="swiper-slide"
  {{ block.shopify_attributes }}
  data-color="{{ block.settings.offer_background_color }} {{ block.settings.offer_heading_color }}"
>
  <div
    class="cart-offer-card__offer-wrapper d-flex justify-content-space-btw"
    style="
      --offer-background-color: {{ block.settings.offer_background_color }};
      --color-link: {{ block.settings.offer_link_text_color }};
    "
  >
    <div class="cart-offer__content-wrapper">
      {% if block.settings.show_icon or block.settings.offer_heading != blank%}
        <div class="cart-offer__icon-wrapper d-flex align-item-center {% if block.settings.offer_subheading != blank %} mb-4{% endif %}">
          {% if block.settings.show_icon %}
          <div
            class="offer-icon d-flex align-item-center"
            style="--icon-width: {{ block.settings.icon_width }}px; --color-icon: {{ block.settings.offer_icon_color }};"
          >
              {% if block.settings.custom_icon != blank %}
                {{
                  block.settings.custom_icon
                  | image_url: width: block.settings.icon_width
                  | image_tag:
                    loading: 'lazy',
                    class: 'w-100',
                    widths: '28,54,72,90',
                    sizes: '28px',
                    alt: block.settings.custom_icon.alt
                }}
              {% else %}
              {% render 'icon' with icon,
                circleColor: 'var(--color-icon)',
                pathColor: 'var(--color-icon)',
                color: 'var(--color-icon)'
              -%}
            {% endif %}
          </div>
        {% endif %}
        {% if block.settings.offer_heading != blank %}
          <p
            class="fnt-14 text-color m-0"
            style="--color-text: {{ block.settings.offer_heading_color }};"
          >
            {{ block.settings.offer_heading }}
          </p>
        {% endif %}
        </div>
      {% endif %}
      <div class="cart-offer__content">
        {% if block.settings.offer_subheading != blank %}
          {%- capture copy_style -%}--color-text: {{ block.settings.offer_subheading_color }}{%- endcapture -%}
          {% render 'copy-code',
            content: block.settings.offer_subheading,
            icon_color: block.settings.offer_subheading_color,
            class: 'text-color fnt-12 m-0',
            style: copy_style,
            is_tabindex: true
          %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Offer",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_icon",
      "label": "Show icon",
      "default": false
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "Style",
      "options": [
        {
          "label": "Globe",
          "value": "globe"
        },
        {
          "value": "truck",
          "label": "Truck"
        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "label": "Delivery box",
          "value": "box"
        },
        {
          "label": "Returns",
          "value": "back"
        },
        {
          "label": "Star",
          "value": "star"
        },
        {
          "label": "Smiley",
          "value": "smile"
        },
        {
          "label": "Heart",
          "value": "heart"
        },
        {
          "label": "Building",
          "value": "building"
        },
        {
          "label": "Timer",
          "value": "timer"
        },
        {
          "label": "Plane",
          "value": "plane"
        },
        {
          "label": "credit",
          "value": "credit-card"
        },
        {
          "label": "lock",
          "value": "lock"
        },
        {
          "label": "shield",
          "value": "shield-strok"
        },
        {
          "label": "money",
          "value": "money"
        }
      ],
      "default": "box",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "range",
      "id": "icon_width",
      "min": 20,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Icon width",
      "default": 25,
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "Custom icon",
      "info": "128 x 128px .png or .svg recommended, Replaces default icon.",
      "visible_if": "{{ block.settings.show_icon }}"
    },
    {
      "type": "inline_richtext",
      "id": "offer_heading",
      "label": "Heading",
      "default": "Limited time offer: 20% off"
    },
    {
      "type": "inline_richtext",
      "id": "offer_subheading",
      "label": "Subheading",
      "default": "Use the code {FLAT20} for 20% off on every product",
      "info": "Wrap your discount code in {} to enable the copy button. Example: {FLAT20}"
    },
    {
      "type": "header",
      "content": "Apperance"
    },
    {
      "type": "color",
      "id": "offer_background_color",
      "label": "Background",
      "alpha": true,
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "offer_heading_color",
      "label": "Heading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "offer_subheading_color",
      "label": "Subheading color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "offer_link_text_color",
      "label": "Link Text color",
      "default": "#b8b8b8"
    },
    {
      "type": "color",
      "id": "offer_icon_color",
      "label": "Icon color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.show_icon }}"
    }
  ],
  "presets": [
    {
      "name": "Offer"
    }
  ]
}
{% endschema %}
