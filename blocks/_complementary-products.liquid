{% assign product = closest.product %}
{% render 'complementary-product-layout', product_id: product.id, block: block %}

{% schema %}
{
  "name": "Complementary products",
  "settings": [
    {
      "type": "paragraph",
      "content": "To select complementary products, add the Search & Discovery app. [Learn more](https://help.shopify.com/manual/online-store/search-and-discovery/product-recommendations)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pair well with",
      "placeholder": "Add heading"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h3",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "range",
      "id": "block_bottom_spacing",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Bottom spacing",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Complementary products",
      "category": "Product"
    }
  ]
}
{% endschema %}
