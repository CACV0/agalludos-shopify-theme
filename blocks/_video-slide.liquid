<div
  class="swiper-slide color-{{ block.settings.color_scheme }} mobile-color-{{ block.settings.color_scheme_mobile }}"
  data-color-scheme="color-{{ block.settings.color_scheme }} mobile-color-{{ block.settings.color_scheme_mobile }}"
  {{ block.shopify_attributes }}
  role="region"
>
  {% assign coverImage = block.settings.cover_image | default: block.settings.slide_video.preview_image %}

  {% assign mobileCoverImage = block.settings.cover_image | default: block.settings.mobile_slide_video.preview_image %}
  {% liquid
    if section.settings.media_size == 'adapt'
      assign ratio = coverImage.aspect_ratio
    endif
    if section.settings.mobile_media_size == 'adapt'
      assign mobile_ratio = coverImage.aspect_ratio
      if mobileCoverImage != blank
        assign mobile_ratio = mobileCoverImage.aspect_ratio
      endif
    endif
    assign video_component = 'default-player'
    assign provide_mobile_video_support = false
    if block.settings.mobile_slide_video and block.settings.enable_mobile_video
      assign provide_mobile_video_support = true
      assign video_component = 'desktop-mobile-video-support'
    endif
  %}
  <div
    style="{% if section.settings.media_size == 'adapt' %}--aspect-ratio: {{ ratio }}; {% endif %} {% if section.settings.mobile_media_size == 'adapt' %}--mobile-aspect-ratio: {{ mobile_ratio }}{% endif %}"
    class="video__section slideshow__slide {% if block.settings.image_video_width == 'full' %} media-size--{{ section.settings.media_size }} {% if section.settings.mobile_media_size == 'adapt' %} mobile_media-size--auto {% else %} mobile_media-size--{{ section.settings.mobile_media_size }} {% endif %} {% endif %}  slideshow__slide--bgColor {% if block.settings.image_video_positin == 'right' %} image-right {% endif %}"
  >
    <div
      class="slideshow__slideImg {% if block.settings.image_video_width == 'full' %} image-full-width {% else %} media-size--{{ section.settings.media_size }} media-size-mobile--{{ section.settings.mobile_media_size }} position-relative {% endif %}"
      image-container
    >
      {% comment %} Half-width: link lives inside the video div so it can only cover the video area, never the content side {% endcomment %}
      {% if block.settings.enable_image_link and block.settings.slide_link != blank %}
        <a
          class="slideshow__slide-link"
          href="{{ block.settings.slide_link }}"
          target="{{ block.settings.slide_link_target }}"
          aria-label="{{ block.settings.slide_link | default: 'Slide link' }}"
        >
      {% endif %}
      {%- assign media_autoplay = block.settings.media_autoplay -%}
      {% if block.settings.overlay_color != 'rgba(0,0,0,0)' %}
        {%- assign overlay_rgba_color = block.settings.overlay_color.rgba -%}
      {%- endif -%}
      {%- assign is_video_width_full = false -%}
      {%- if block.settings.image_video_width == 'full' -%}
        {%- assign is_video_width_full = true -%}
      {%- endif -%}
      {% comment %} Display Play button if autoplay is true for media {% endcomment %}
      {%- capture display_video_overlay_elements -%}
                            {% if block.settings.overlay_color != 'rgba(0,0,0,0)' %}
                            <div class="video__overlay__elements" video-overlay-elements>
                              <div class="video__overlay__elements__wrapper">
                              </div>
                              </div>
                            {% endif %}
                        {%- endcapture -%}
      {% if block.settings.slide_video != blank or provide_mobile_video_support %}
        {% comment %} {% render 'media-new', media: video_url, show_preview_image: render_preview_image | default: false, media_autoplay: media_autoplay %} {% endcomment %}
        <animation-reveal aoi-type="scale" aoi-delay="0.2" aoi-duration="0.6" aoi-amount="0">
          <{{ video_component }}
            class="d-block custom__player__element position-relative set-100-percentage-size-media"
            watch-element
            data-media-type="video"
            media-autoplay
            role="group"
            aria-label="Video Player"
          >
            <video
              preload="metadata"
              poster="false"
              webkit-playsinline
              playsinline
              muted
              autoplay
              loop
              {% if block.settings.slide_video.alt %}
                aria-label="{{ block.settings.slide_video.alt}}"
              {% endif %}
            >
              {%- for source in block.settings.slide_video.sources -%}
                <source
                  {% if provide_mobile_video_support %}
                    desktop-sources
                  {% endif %}
                  data-src="{{ source.url }}"
                  type="{{ source.mime_type }}"
                >
              {%- endfor -%}

              {% if provide_mobile_video_support %}
                {%- for source in block.settings.mobile_slide_video.sources -%}
                  <source mobile-sources data-src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              {% endif %}
              Your browser does not support the video tag.
            </video>
            {{ display_video_overlay_elements }}
            <div
              class="set-100-percentage-size-media media-preview-element {% unless section.settings.media_size == 'auto' %} position-absolute {% else %} position-relative {% endunless %} {% unless section.settings.media_size_mobile == 'auto' %} position-absolute-md {% else %} position-relative-md {% endunless %}"
              video-preview-elements
            >
              {%- if block.settings.slide_video != blank or block.settings.mobile_slide_video != blank -%}
                {% if block.settings.slide_video != blank and coverImage != blank %}
                  {% capture class_name %}
                              {% if  provide_mobile_video_support %} tab-only  {% endif %} set-100-percentage-size-media
                              {% endcapture %}
                  {{
                    coverImage
                    | image_url: width: coverImage.width
                    | image_tag:
                      widths: '340,767,980,1024',
                      sizes: '(max-width: 520px) 340px,(max-width: 767px) 767px,(max-width: 980px) 980px,(max-width: 1024) 1024px',
                      alt: coverImage.alt,
                      loading: loading,
                      fetchpriority: fetchpriority,
                      class: class_name,
                      is: 'image-loading'
                  }}
                {% endif %}

                {% if block.settings.mobile_slide_video != blank and mobileCoverImage != blank %}
                  {{
                    mobileCoverImage
                    | image_url: width: mobileCoverImage.width
                    | image_tag:
                      widths: '340,512,767',
                      sizes: '(max-width: 520px) 340px,(max-width: 767px) 767px',
                      alt: mobileCoverImage.alt,
                      loading: loading,
                      fetchpriority: fetchpriority,
                      class: 'set-100-percentage-size-media mobile-only',
                      is: 'image-loading'
                  }}
                {% endif %}
              {%- endif -%}
            </div>
            <div
              class="video__overlay position-absolute {% if block.settings.hide_on_desktop %} hide-over-on-desktop {% endif %}"
              style="background-color: rgba({{ overlay_rgba_color }})"
              video-overlay-elements
            ></div>
          </{{ video_component }}>
        </animation-reveal>
        {% if coverImage != blank %}
          {{
            coverImage
            | image_url: width: 40
            | image_tag: class: 'blur-image', loading: loading, fetchpriority: fetchpriority, alt: coverImage.alt
          }}
        {% endif %}
        {% if provide_mobile_video_support and mobileCoverImage != blank %}
          {{
            mobileCoverImage
            | image_url: width: 40
            | image_tag:
              class: 'blur-image mobile-only',
              loading: loading,
              fetchpriority: fetchpriority,
              alt: mobileCoverImage.alt
          }}
        {% endif %}
      {%- endif -%}
      {% if block.settings.slide_video == blank %}
        <animation-reveal
          aoi-type="scale"
          aoi-delay="0.2"
          aoi-duration="0.6"
          aoi-amount="0"
          class="{% if block.settings.slide_video == blank and provide_mobile_video_support %}tab-only{% endif %}"
        >
          {%- if coverImage != blank -%}
            {{
              coverImage
              | image_url: width: coverImage.width
              | image_tag:
                widths: '340,767,980,1024',
                sizes: '(max-width: 520px) 340px,(max-width: 767px) 767px,(max-width: 980px) 980px,(max-width: 1024) 1024px',
                alt: coverImage.alt,
                loading: loading,
                fetchpriority: fetchpriority,
                class: 'set-100-percentage-size-media',
                is: 'image-loading'
            }}
          {% else %}
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'set-100-percentage-size-media' }}
          {% endif %}
        </animation-reveal>
        {% if block.settings.slide_video == blank and coverImage != blank %}
          {{
            coverImage
            | image_url: width: 40
            | image_tag: class: 'blur-image', loading: loading, fetchpriority: fetchpriority, alt: coverImage.alt
          }}
        {% endif %}
      {%- endif -%}

      {% if block.settings.enable_image_link and block.settings.slide_link != blank %}
        </a>
      {% endif %}
    </div>
    <div class="{% if section.settings.section_width %} container {% else %} d-flex flex-1 {% endif %}{% if block.settings.image_video_width == 'full' %} full-image-content {% endif %} {% unless block.settings.image_video_width == 'full' %} slideshow__slideContent {% endunless %} content-desktop-alignment-{{ block.settings.desktop_content_position }} content-mobile-alignment-{{ block.settings.mobile_content_position }}">
      <div
        class="slideshow__slideBody {% unless section.settings.section_width or block.settings.image_video_width == 'half' %} fix-width-container {% endunless %} {% unless section.settings.desktop_navigation == 'arrows' %} arrows-not-at-verticle-center {% endunless %} text-{{ block.settings.desktop_content_alignment }} text-{{ block.settings.mobile_content_alignment }}-md margin-{{ block.settings.desktop_content_alignment }} margin-{{ block.settings.mobile_content_alignment }}-md"
        style="--slider-content-width: {{ block.settings.content_width | append: "px" }}"
      >
        {% content_for 'blocks' %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video slide",
  "tag": null,
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "select",
      "id": "image_video_width",
      "label": "Video width",
      "options": [
        {
          "label": "Full",
          "value": "full"
        },
        {
          "label": "Half",
          "value": "half"
        }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "image_video_positin",
      "label": "Video position",
      "info": "Only applicable when ‘video width’ is set to ‘half’",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "default": "left"
    },
    {
      "type": "video",
      "id": "slide_video",
      "label": "Desktop video",
      "info": "Videos are muted and autoplayed"
    },
    {
      "type": "checkbox",
      "id": "enable_mobile_video",
      "label": "Add mobile video",
      "default": false
    },
    {
      "type": "video",
      "id": "mobile_slide_video",
      "label": "Mobile Video",
      "info": "Videos are muted and autoplayed",
      "visible_if": "{{ block.settings.enable_mobile_video}}"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image",
      "info": "2880 x 1280px (large) .jpg recommended"
    },
    {
      "type": "checkbox",
      "id": "enable_image_link",
      "label": "Enable full slideshow click area",
      "info": "Makes the entire slide clickable",
      "default": false
    },
    {
      "type": "url",
      "id": "slide_link",
      "label": "Link URL",
      "visible_if": "{{ block.settings.enable_image_link }}"
    },
    {
      "type": "select",
      "id": "slide_link_target",
      "label": "Open link in",
      "options": [
        {
          "label": "Same tab",
          "value": "_top"
        },
        {
          "label": "New tab",
          "value": "_blank"
        }
      ],
      "default": "_top",
      "visible_if": "{{ block.settings.enable_image_link }}"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "range",
      "label": "Content width",
      "id": "content_width",
      "min": 400,
      "max": 1200,
      "step": 20,
      "unit": "px",
      "default": 420,
      "info": "Works only when 'video width' is set to Full"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "text_alignment",
      "id": "desktop_content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "label": "Content position",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text_alignment",
      "id": "mobile_content_alignment",
      "label": "Content alignment",
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_content_position",
      "label": "Content position",
      "options": [
        {
          "label": "Top",
          "value": "top"
        },
        {
          "label": "Center",
          "value": "center"
        },
        {
          "label": "Bottom",
          "value": "bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide overlay on desktop",
      "info": "Enabling this will show overlay only on mobile layout.Recommended when image width is set to half.",
      "default": true
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay",
      "alpha": true,
      "default": "#0000005B"
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "Desktop color scheme"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme_mobile",
      "default": "scheme-5",
      "label": "Mobile color scheme"
    }
  ],
  "presets": [
    {
      "name": "Video slide",
      "blocks": [
        {
          "type": "sub-heading"
        },
        {
          "type": "heading"
        },
        {
          "type": "paragraph"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
