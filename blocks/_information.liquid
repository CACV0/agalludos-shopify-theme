{% comment %}
  Information block — one tab (head + panel) inside the Nutritional Block.
  The head's data-id matches the panel's id, which is how <tabs-toggle> pairs them.
{% endcomment %}

{%- if block.settings.tab_label != blank -%}
  <button
    tab-head
    type="button"
    class="nutritional-tabs__tab fnt-heading"
    data-id="{{ block.id }}"
  >
    <span class="nutritional-tabs__tab-label d-flex align-item-center justify-content-center">{{ block.settings.tab_label | escape }}</span>
  </button>
{%- endif -%}

<div
  tab-body
  id="{{ block.id }}"
  class="nutritional-tabs__panel"
  {{ block.shopify_attributes }}
>
  {% render 'information-content', block: block %}
</div>

{% schema %}
{
  "name": "Information",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "tab_label",
      "label": "Tab label"
    },
    {
      "type": "text",
      "id": "left_label",
      "label": "Left column label",
      "default": "NUTRITION FACTS"
    },
    {
      "type": "text",
      "id": "right_label",
      "label": "Right column label",
      "default": "Serving Size 1 can (300ml)",
      "info": "For mobile, if the left column text is too long, the right column will shift down automatically."
    },
    {
      "type": "richtext",
      "id": "information",
      "label": "Information",
      "info": "Separate label and value with a colon \" : \", use line breaks for new rows, a hyphen to indent. [Learn more](https://help.ascendthemes.com/article/119-nutrition-information)",
      "default": "<h2>Calories: 15 kcal</h2><p>Total Fat: 0g: 0%</p><p>Sodium: 30mg: 1%</p><p>Total Carbohydrate: 3g: 1%</p><p>- Dietary Fiber: 0g: 0%</p><p>- Total Sugars: 0g</p><p>Protein: 1g</p><p>Caffeine: 150mg</p>"
    },
    {
      "type": "richtext",
      "id": "extra_information",
      "label": "Extra information",
      "default": "<p>* Not a significant source of saturated fat, trans fat, cholesterol, vitamin D, calcium, iron, or potassium.</p>"
    }
  ],
  "presets": [
    {
      "name": "Information"
    }
  ]
}
{% endschema %}
